<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:theme="clr-namespace:MapWizard.Theme.Controls;assembly=MapWizard.Theme"
    xmlns:controls="clr-namespace:MapWizard.Desktop.Views.Controls"
    xmlns:appControls="clr-namespace:MapWizard.Desktop.Controls"
    xmlns:viewModels="clr-namespace:MapWizard.Desktop.ViewModels"
    mc:Ignorable="d"
    d:DesignWidth="800"
    d:DesignHeight="450"
    x:Class="MapWizard.Desktop.Views.MapCleaner.MapCleanerView"
    x:DataType="viewModels:MapCleanerViewModel"
    x:Name="Root"
    Padding="16">
    <UserControl.Styles>
        <Style Selector="Border.SnapChip">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapWizardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.SnapChip TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="Border.SnapChip materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="Button.SnapChipClose">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.SnapChipClose:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltMediumBrush}" />
        </Style>
        <Style Selector="Button.SnapPresetBadge">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapWizardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinWidth" Value="48" />
        </Style>
        <Style Selector="Button.SnapPresetBadge:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltMediumBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapWizardAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <TextBlock
                Grid.Row="0"
                Text="Map Cleaner"
                FontSize="24"
                FontWeight="Bold"
                VerticalAlignment="Center"
                Margin="16,0" />

            <Button Grid.Column="1"
                    Classes="Flat Large"
                    Command="{Binding CleanMapsCommand}"
                    ToolTip.Tip="Apply map cleaner actions">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="ContentSave" Width="24" Height="24" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Normal"
                        FontSize="16"
                        Text="Clean Beatmap" />
                </StackPanel>
            </Button>
        </Grid>

        <Separator Grid.Row="1" Margin="0 10 0 5" />

        <appControls:SmoothScrollViewer Grid.Row="2">
            <StackPanel Spacing="16">
                <controls:BeatmapSelectionPanel
                    SectionTitle="Beatmap Selection"
                    OriginMap="{Binding OriginBeatmap}"
                    DestinationMaps="{Binding DestinationBeatmaps}"
                    SourceSubtitle="Select the beatmap you want to clean."
                    ShowDestinationSelection="False"
                    OriginPathChangedCommand="{Binding ReanalyzeOriginAfterPathChangeCommand}" />

                <theme:CollapsibleSection Header="Beat Snaps">
                    <StackPanel Spacing="8">
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding ActiveSnapDivisors}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="999"
                                                Padding="10,5"
                                                Margin="0,0,6,6"
                                                Classes="SnapChip">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                                <Button Classes="SnapChipClose"
                                                        Command="{ReflectionBinding DataContext.RemoveSnapCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Remove snap">
                                                    <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Classes="Basic Compact"
                                    Margin="0,0,6,6"
                                    ToolTip.Tip="Add snap from presets">
                                <TextBlock Text="+ Presets" />
                                <Button.Flyout>
                                    
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <Border Classes="PopupSurface"
                                                Width="290"
                                                Padding="10">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Preset Snaps"
                                                           FontWeight="Normal"
                                                           FontSize="13" />
                                                <Separator />
                                                <appControls:SmoothScrollViewer MaxHeight="220">
                                                    <ItemsControl ItemsSource="{ReflectionBinding DataContext.SnapPresets, ElementName=Root}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Classes="SnapPresetBadge Compact"
                                                                        Margin="0,0,6,6"
                                                                        Command="{ReflectionBinding DataContext.AddSnapFromFlyoutCommand, ElementName=Root}"
                                                                        CommandParameter="{Binding}">
                                                                    <TextBlock Text="{Binding}" />
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </appControls:SmoothScrollViewer>
                                                <Separator />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBox Width="170"
                                                             PlaceholderText="Custom 1/x"
                                                             Text="{ReflectionBinding DataContext.CustomSnapInput, Mode=TwoWay, ElementName=Root}" />
                                                    <Button Classes="Basic Compact"
                                                            Command="{ReflectionBinding DataContext.AddCustomSnapCommand, ElementName=Root}">
                                                        <TextBlock Text="Add" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </theme:CollapsibleSection>
                <theme:CollapsibleSection Header="Actions">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Resnap everything" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ResnapEverything}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Remove muting" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding RemoveMuting}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Remove unused greenlines" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding RemoveUnusedGreenlines}" />
                        </Grid>
                    </StackPanel>
                </theme:CollapsibleSection>
            </StackPanel>
        </appControls:SmoothScrollViewer>
    </Grid>
</UserControl>
