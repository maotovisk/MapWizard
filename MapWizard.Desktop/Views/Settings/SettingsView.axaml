<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MapWizard.Desktop.ViewModels"
    xmlns:controls="clr-namespace:MapWizard.Desktop.Views.Controls"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:settingsModels="clr-namespace:MapWizard.Desktop.Models.Settings"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:objectModel="clr-namespace:System.Collections.ObjectModel;assembly=System.ObjectModel"
    x:Class="MapWizard.Desktop.Views.Settings.SettingsView"
    x:DataType="vm:SettingsViewModel"
    d:DesignWidth="800"
    d:DesignHeight="450"
    mc:Ignorable="d"
    Padding="24">
    <UserControl.Styles>
        <Style Selector="ListBox.palette-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.palette-list ListBoxItem">
            <Setter Property="Width" Value="224" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SukiControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="ListBox.palette-list ListBoxItem:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SukiLowText}" />
        </Style>
        <Style Selector="ListBox.palette-list ListBoxItem:selected">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ListBox.palette-list ListBoxItem:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <suki:SettingsLayout>
        <suki:SettingsLayout.Items>
            <objectModel:ObservableCollection x:TypeArguments="suki:SettingsLayoutItem">
                <suki:SettingsLayoutItem Header="Appearance">
                    <suki:SettingsLayoutItem.Content>
                        <StackPanel Spacing="20">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Text="Variant" FontWeight="Bold" VerticalAlignment="Center" />
                                <controls:AppDropdown Grid.Column="1"
                                                      MinWidth="140"
                                                      FlyoutMinWidth="180"
                                                      FlyoutMaxHeight="280"
                                                      PlaceholderText="Select variant"
                                                      ItemsSource="{Binding ThemeModes}"
                                                      SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}" />
                            </Grid>

                            <StackPanel Spacing="10">
                                <TextBlock Text="Color palette" FontWeight="Bold" />
                                <ListBox Classes="palette-list"
                                         ItemsSource="{Binding ColorPalettes}"
                                         SelectedItem="{Binding SelectedColorPalette, Mode=TwoWay}"
                                         SelectionMode="Single"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="settingsModels:ThemePaletteOption">
                                            <Grid RowDefinitions="92,Auto">
                                                <Border CornerRadius="7,7,0,0" ClipToBounds="True">
                                                    <Grid ColumnDefinitions="*,*">
                                                        <Border Background="{Binding DarkBackgroundBrush}">
                                                            <Grid Margin="9" RowDefinitions="12,*">
                                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                                    <Border Width="5" Height="5" CornerRadius="3" Background="{Binding DarkAccentBrush}" />
                                                                    <Border Width="28" Height="4" CornerRadius="2" Background="{Binding DarkTextBrush}" Opacity="0.48" />
                                                                </StackPanel>
                                                                <Border Grid.Row="1"
                                                                        Margin="0,5,0,0"
                                                                        Padding="7"
                                                                        CornerRadius="5"
                                                                        Background="{Binding DarkSurfaceBrush}">
                                                                    <StackPanel Spacing="6">
                                                                        <Border Height="6" CornerRadius="3" Background="{Binding DarkAccentBrush}" />
                                                                        <Border Width="55" Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="{Binding DarkTextBrush}" Opacity="0.72" />
                                                                        <Border Width="38" Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="{Binding DarkTextBrush}" Opacity="0.38" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <Border Grid.Column="1" Background="{Binding LightBackgroundBrush}">
                                                            <Grid Margin="9" RowDefinitions="12,*">
                                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                                    <Border Width="5" Height="5" CornerRadius="3" Background="{Binding LightAccentBrush}" />
                                                                    <Border Width="28" Height="4" CornerRadius="2" Background="{Binding LightTextBrush}" Opacity="0.40" />
                                                                </StackPanel>
                                                                <Border Grid.Row="1"
                                                                        Margin="0,5,0,0"
                                                                        Padding="7"
                                                                        CornerRadius="5"
                                                                        Background="{Binding LightSurfaceBrush}">
                                                                    <StackPanel Spacing="6">
                                                                        <Border Height="6" CornerRadius="3" Background="{Binding LightAccentBrush}" />
                                                                        <Border Width="55" Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="{Binding LightTextBrush}" Opacity="0.66" />
                                                                        <Border Width="38" Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="{Binding LightTextBrush}" Opacity="0.32" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Row="1"
                                                           Margin="10,8"
                                                           Text="{Binding Name}"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Text="Smooth wheel scrolling" FontWeight="Bold" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding IsSmoothWheelScrollingEnabled, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </suki:SettingsLayoutItem.Content>
                </suki:SettingsLayoutItem>

                <suki:SettingsLayoutItem Header="General">
                    <suki:SettingsLayoutItem.Content>
                        <StackPanel Spacing="20">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Update Stream" FontWeight="Bold" />
                                    <TextBlock Text="Release checks only stable releases. PreRelease checks both pre-releases and stable releases."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <controls:AppDropdown Grid.Column="1"
                                                      FlyoutMinWidth="180"
                                                      FlyoutMaxHeight="280"
                                                      MinWidth="140"
                                                      PlaceholderText="Select update stream"
                                                      ItemsSource="{Binding UpdateStreams}"
                                                      SelectedItem="{Binding UpdateStream, Mode=TwoWay}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Top">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Songs Folder" FontWeight="Bold" />
                                    <TextBlock Text="Map Picker uses this folder to display recent beatmaps and their backgrounds."
                                               TextWrapping="Wrap" />
                                    <TextBox Text="{Binding SongsPath, Mode=TwoWay}"
                                             PlaceholderText="Path to osu! Songs folder"
                                             Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding SongsPathStatusText}"
                                               FontSize="12"
                                               Opacity="0.82" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Classes="Basic"
                                        VerticalAlignment="Top"
                                        Command="{Binding PickSongsFolderCommand}">
                                    <TextBlock Text="Browse" />
                                </Button>

                                <Button Grid.Column="2"
                                        Classes="Flat"
                                        VerticalAlignment="Top"
                                        Command="{Binding AutoDetectSongsFolderCommand}">
                                    <TextBlock Text="Auto Detect" />
                                </Button>
                            </Grid>

                            <Button Classes="Flat Compact"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{Binding CanRestartToApplyUpdate}"
                                    Command="{Binding RestartToApplyUpdateCommand}">
                                <TextBlock Text="{Binding UpdateStreamBadgeText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextDecorations="Underline" />
                            </Button>
                        </StackPanel>
                    </suki:SettingsLayoutItem.Content>
                </suki:SettingsLayoutItem>

                <suki:SettingsLayoutItem Header="Experimental">
                    <suki:SettingsLayoutItem.Content>
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Enable Hitsound Visualizer" FontWeight="Bold" />
                                <TextBlock Text="Shows the Hitsound Visualizer tool in the sidebar when enabled."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding IsHitSoundVisualizerEnabled, Mode=TwoWay}" />
                        </Grid>
                    </suki:SettingsLayoutItem.Content>
                </suki:SettingsLayoutItem>

                <suki:SettingsLayoutItem Header="Audio">
                    <suki:SettingsLayoutItem.Content>
                        <StackPanel Spacing="20">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Audio Output Device" FontWeight="Bold" />
                                    <TextBlock Text="Select the playback device used by editor audio preview features."
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding AudioOutputDeviceStatusText}"
                                               FontSize="12"
                                               Opacity="0.82" />
                                </StackPanel>
                                <controls:AppDropdown Grid.Column="1"
                                                      MinWidth="260"
                                                      MaxWidth="380"
                                                      FlyoutMinWidth="320"
                                                      FlyoutMaxHeight="320"
                                                      PlaceholderText="Select output device"
                                                      ItemsSource="{Binding AudioOutputDevices}"
                                                      SelectedItem="{Binding SelectedAudioOutputDevice, Mode=TwoWay}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Preview Song Volume" FontWeight="Bold" />
                                    <TextBlock Text="Default music volume for editor audio previews (including the Hitsound Visualizer)."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Slider Width="180"
                                            Minimum="0"
                                            Maximum="100"
                                            TickFrequency="1"
                                            Value="{Binding AudioPreviewSongVolumePercent, Mode=TwoWay}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding AudioPreviewSongVolumePercent, StringFormat={}{0}%}" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Preview Hitsound Volume" FontWeight="Bold" />
                                    <TextBlock Text="Default hitsound volume for editor audio previews (including the Hitsound Visualizer)."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Slider Width="180"
                                            Minimum="0"
                                            Maximum="100"
                                            TickFrequency="1"
                                            Value="{Binding AudioPreviewHitSoundVolumePercent, Mode=TwoWay}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding AudioPreviewHitSoundVolumePercent, StringFormat={}{0}%}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </suki:SettingsLayoutItem.Content>
                </suki:SettingsLayoutItem>

                <suki:SettingsLayoutItem Header="Information">
                    <suki:SettingsLayoutItem.Content>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Config Directory:" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ConfigDirectoryPath}"
                                       ToolTip.Tip="{Binding ConfigDirectoryPath}"
                                       TextTrimming="CharacterEllipsis"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Classes="Basic Compact"
                                    Width="32"
                                    Height="30"
                                    Padding="4"
                                    Command="{Binding OpenConfigDirectoryCommand}"
                                    ToolTip.Tip="Open config directory"
                                    AutomationProperties.Name="Open config directory">
                                <materialIcons:MaterialIcon Kind="FolderOpen" Width="18" Height="18" />
                            </Button>
                        </Grid>
                    </suki:SettingsLayoutItem.Content>
                </suki:SettingsLayoutItem>
            </objectModel:ObservableCollection>
        </suki:SettingsLayout.Items>
    </suki:SettingsLayout>
</UserControl>
