<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MapWizard.Desktop.ViewModels"
    xmlns:controls="clr-namespace:MapWizard.Desktop.Views.Controls"
    xmlns:appControls="clr-namespace:MapWizard.Desktop.Controls"
    xmlns:settingsModels="clr-namespace:MapWizard.Desktop.Models.Settings"
    xmlns:theme="clr-namespace:MapWizard.Theme.Controls;assembly=MapWizard.Theme"
    x:Class="MapWizard.Desktop.Views.Settings.SettingsView"
    x:DataType="vm:SettingsViewModel"
    d:DesignWidth="800"
    d:DesignHeight="450"
    mc:Ignorable="d"
    Padding="20">
    <UserControl.Styles>
        <Style Selector="ListBox.palette-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.palette-list ListBoxItem">
            <Setter Property="Width" Value="224" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Background" Value="{DynamicResource MapWizardCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapWizardControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="ListBox.palette-list ListBoxItem:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource MapWizardTextSecondaryBrush}" />
        </Style>
        <Style Selector="ListBox.palette-list ListBoxItem:selected">
            <Setter Property="BorderBrush" Value="{DynamicResource MapWizardAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ListBox.palette-list ListBoxItem:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource MapWizardAccentBrush}" />
        </Style>
        <Style Selector="RadioButton.SettingsNav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="3,*" ColumnSpacing="8">
                            <Border x:Name="SelectionMarker"
                                    Width="3"
                                    CornerRadius="2"
                                    Background="{DynamicResource MapWizardAccentBrush}"
                                    Opacity="0" />
                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.SettingsNav:pointerover">
            <Setter Property="Background" Value="{DynamicResource MapWizardControlHoverBrush}" />
        </Style>
        <Style Selector="RadioButton.SettingsNav:checked">
            <Setter Property="Background" Value="{DynamicResource MapWizardAccent25Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource MapWizardAccentBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="RadioButton.SettingsNav:checked /template/ Border#SelectionMarker">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="SettingsLayoutRoot" SizeChanged="SettingsLayoutRoot_OnSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="SettingsCategoryRail" Margin="0,4,16,0" Spacing="3">
            <TextBlock Text="SETTINGS" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource MapWizardTextSecondaryBrush}"
                       Margin="9,0,0,6" />
            <RadioButton x:Name="GeneralNav" Classes="SettingsNav" Content="General" Tag="General" IsChecked="True" Click="CategoryButton_OnClick" />
            <RadioButton x:Name="AppearanceNav" Classes="SettingsNav" Content="Appearance" Tag="Appearance" Click="CategoryButton_OnClick" />
            <RadioButton x:Name="AudioNav" Classes="SettingsNav" Content="Audio" Tag="Audio" Click="CategoryButton_OnClick" />
            <RadioButton x:Name="InformationNav" Classes="SettingsNav" Content="Information" Tag="Information" Click="CategoryButton_OnClick" />
            <RadioButton x:Name="SupportNav" Classes="SettingsNav" Content="Support" Tag="Support" Click="CategoryButton_OnClick" />
        </StackPanel>

        <appControls:SmoothScrollViewer x:Name="SettingsScrollViewer"
                                        Grid.Column="1"
                                        HorizontalScrollBarVisibility="Disabled"
                                        ScrollChanged="SettingsScrollViewer_OnScrollChanged">
            <StackPanel x:Name="SettingsSections" MaxWidth="980" HorizontalAlignment="Stretch">
                <theme:Surface x:Name="GeneralSection" Margin="0,0,0,16" Padding="20"><theme:SectionGroup Header="General">
                        <StackPanel Spacing="20">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Update Stream" FontWeight="Bold" />
                                    <TextBlock Text="Release checks only stable releases. PreRelease checks both pre-releases and stable releases."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <controls:AppDropdown Grid.Column="1"
                                                      FlyoutMinWidth="180"
                                                      FlyoutMaxHeight="280"
                                                      MinWidth="140"
                                                      PlaceholderText="Select update stream"
                                                      ItemsSource="{Binding UpdateStreams}"
                                                      SelectedItem="{Binding UpdateStream, Mode=TwoWay}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Top">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Songs Folder" FontWeight="Bold" />
                                    <TextBlock Text="Map Picker uses this folder to display recent beatmaps and their backgrounds."
                                               TextWrapping="Wrap" />
                                    <TextBox Text="{Binding SongsPath, Mode=TwoWay}"
                                             PlaceholderText="Path to osu! Songs folder"
                                             Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding SongsPathStatusText}"
                                               FontSize="12"
                                               Opacity="0.82" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Classes="Basic"
                                        VerticalAlignment="Top"
                                        Command="{Binding PickSongsFolderCommand}">
                                    <TextBlock Text="Browse" />
                                </Button>

                                <Button Grid.Column="2"
                                        Classes="Flat"
                                        VerticalAlignment="Top"
                                        Command="{Binding AutoDetectSongsFolderCommand}">
                                    <TextBlock Text="Auto Detect" />
                                </Button>
                            </Grid>
                        </StackPanel>
                </theme:SectionGroup></theme:Surface>

                <theme:Surface x:Name="AppearanceSection" Margin="0,0,0,16" Padding="20"><theme:SectionGroup Header="Appearance">
                        <StackPanel Spacing="20">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Text="Variant" FontWeight="Bold" VerticalAlignment="Center" />
                                <controls:AppDropdown Grid.Column="1"
                                                      MinWidth="140"
                                                      FlyoutMinWidth="180"
                                                      FlyoutMaxHeight="280"
                                                      PlaceholderText="Select variant"
                                                      ItemsSource="{Binding ThemeModes}"
                                                      SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}" />
                            </Grid>

                            <StackPanel Spacing="10">
                                <TextBlock Text="Color palette" FontWeight="Bold" />
                                <ListBox Classes="palette-list"
                                         ItemsSource="{Binding ColorPalettes}"
                                         SelectedItem="{Binding SelectedColorPalette, Mode=TwoWay}"
                                         SelectionMode="Single"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="settingsModels:ThemePaletteOption">
                                            <Grid RowDefinitions="92,Auto">
                                                <Border CornerRadius="7,7,0,0" ClipToBounds="True">
                                                    <Grid ColumnDefinitions="*,*">
                                                        <Border Background="{Binding DarkBackgroundBrush}">
                                                            <Grid Margin="9" RowDefinitions="12,*">
                                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                                    <Border Width="5" Height="5" CornerRadius="3" Background="{Binding DarkAccentBrush}" />
                                                                    <Border Width="28" Height="4" CornerRadius="2" Background="{Binding DarkTextBrush}" Opacity="0.48" />
                                                                </StackPanel>
                                                                <Border Grid.Row="1"
                                                                        Margin="0,5,0,0"
                                                                        Padding="7"
                                                                        CornerRadius="5"
                                                                        Background="{Binding DarkSurfaceBrush}">
                                                                    <StackPanel Spacing="6">
                                                                        <Border Height="6" CornerRadius="3" Background="{Binding DarkAccentBrush}" />
                                                                        <Border Width="55" Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="{Binding DarkTextBrush}" Opacity="0.72" />
                                                                        <Border Width="38" Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="{Binding DarkTextBrush}" Opacity="0.38" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <Border Grid.Column="1" Background="{Binding LightBackgroundBrush}">
                                                            <Grid Margin="9" RowDefinitions="12,*">
                                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                                    <Border Width="5" Height="5" CornerRadius="3" Background="{Binding LightAccentBrush}" />
                                                                    <Border Width="28" Height="4" CornerRadius="2" Background="{Binding LightTextBrush}" Opacity="0.40" />
                                                                </StackPanel>
                                                                <Border Grid.Row="1"
                                                                        Margin="0,5,0,0"
                                                                        Padding="7"
                                                                        CornerRadius="5"
                                                                        Background="{Binding LightSurfaceBrush}">
                                                                    <StackPanel Spacing="6">
                                                                        <Border Height="6" CornerRadius="3" Background="{Binding LightAccentBrush}" />
                                                                        <Border Width="55" Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="{Binding LightTextBrush}" Opacity="0.66" />
                                                                        <Border Width="38" Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="{Binding LightTextBrush}" Opacity="0.32" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Row="1"
                                                           Margin="10,8"
                                                           Text="{Binding Name}"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Text="Smooth Scrolling" FontWeight="Bold" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding IsSmoothWheelScrollingEnabled, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                </theme:SectionGroup></theme:Surface>

                <theme:Surface x:Name="AudioSection" Margin="0,0,0,16" Padding="20"><theme:SectionGroup Header="Audio">
                        <StackPanel Spacing="20">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Audio Output Device" FontWeight="Bold" />
                                    <TextBlock Text="Select the playback device used by editor audio preview features."
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding AudioOutputDeviceStatusText}"
                                               FontSize="12"
                                               Opacity="0.82" />
                                </StackPanel>
                                <controls:AppDropdown Grid.Column="1"
                                                      MinWidth="260"
                                                      MaxWidth="380"
                                                      FlyoutMinWidth="320"
                                                      FlyoutMaxHeight="320"
                                                      PlaceholderText="Select output device"
                                                      ItemsSource="{Binding AudioOutputDevices}"
                                                      SelectedItem="{Binding SelectedAudioOutputDevice, Mode=TwoWay}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Song Volume" FontWeight="Bold" />
                                    <TextBlock Text="Default music volume for editor audio previews (including the HitSound Editor)."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Slider Width="180"
                                            Minimum="0"
                                            Maximum="100"
                                            TickFrequency="1"
                                            Value="{Binding AudioPreviewSongVolumePercent, Mode=TwoWay}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding AudioPreviewSongVolumePercent, StringFormat={}{0}%}" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Hitsound Volume" FontWeight="Bold" />
                                    <TextBlock Text="Default hitsound volume for editor audio previews (including the HitSound Editor)."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Slider Width="180"
                                            Minimum="0"
                                            Maximum="100"
                                            TickFrequency="1"
                                            Value="{Binding AudioPreviewHitSoundVolumePercent, Mode=TwoWay}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding AudioPreviewHitSoundVolumePercent, StringFormat={}{0}%}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                </theme:SectionGroup></theme:Surface>

                <theme:Surface x:Name="InformationSection" Margin="0,0,0,16" Padding="20"><theme:SectionGroup Header="Information">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Config Directory:" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ConfigDirectoryPath}"
                                       ToolTip.Tip="{Binding ConfigDirectoryPath}"
                                       TextTrimming="CharacterEllipsis"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Classes="Basic Compact"
                                    Width="32"
                                    Height="30"
                                    Padding="4"
                                    Command="{Binding OpenConfigDirectoryCommand}"
                                    ToolTip.Tip="Open config directory"
                                    AutomationProperties.Name="Open config directory">
                                <LucideIcon Kind="FolderOpen" Size="18" />
                            </Button>
                        </Grid>
                </theme:SectionGroup></theme:Surface>

                <theme:Surface x:Name="SupportSection" Margin="0,0,0,16" Padding="20"><theme:SectionGroup Header="Support">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                <LucideIcon Kind="Info" Size="20" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding VersionLabel}" FontWeight="Bold" />
                                    <TextBlock Text="The MapWizard build currently running."
                                               FontSize="12"
                                               Opacity="0.82" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Classes="Basic Compact"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding CanRestartToApplyUpdate}"
                                        Command="{Binding RestartToApplyUpdateCommand}">
                                    <TextBlock Text="{Binding UpdateStreamBadgeText}"
                                               FontSize="12"
                                               FontWeight="Normal" />
                                </Button>
                            </Grid>

                            <TextBlock TextWrapping="Wrap"
                                       Text="Need a hand or found a bug? Join the Discord for quick questions, or open an issue on GitHub. When reporting a problem, include your version, operating system, and the steps that reproduce it." />

                            <WrapPanel>
                                <Button Classes="Basic" Margin="0,0,8,8" Command="{Binding OpenDiscordCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{DynamicResource MapWizardTextBrush}"
                                                      Data="{StaticResource BrandDiscord}" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Join the Discord" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="Basic" Margin="0,0,8,8" Command="{Binding OpenIssuesCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <LucideIcon Kind="Bug" Size="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Report an issue" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="Basic" Margin="0,0,8,8" Command="{Binding OpenDocumentationCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <LucideIcon Kind="BookOpen" Size="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Documentation" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                </theme:SectionGroup></theme:Surface>
            </StackPanel>
        </appControls:SmoothScrollViewer>
    </Grid>
</UserControl>
