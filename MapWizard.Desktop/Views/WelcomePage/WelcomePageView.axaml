<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:MapWizard.Desktop.ViewModels"
    xmlns:models="clr-namespace:MapWizard.Desktop.Models"
    xmlns:controls="clr-namespace:MapWizard.Desktop.Views.Controls"
    xmlns:appControls="clr-namespace:MapWizard.Desktop.Controls"
    mc:Ignorable="d"
    d:DesignWidth="900"
    d:DesignHeight="600"
    x:Class="MapWizard.Desktop.Views.WelcomePage.WelcomePageView"
    x:DataType="vm:WelcomePageViewModel"
    Padding="28">
    <UserControl.Styles>
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.6" />
            <Setter Property="Foreground" Value="{DynamicResource MapWizardTextSecondaryBrush}" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>

        <!-- List row: no borders, soft rounded hover. Hover feedback is instant
             (no transitions) so the list feels responsive. -->
        <Style Selector="Button.list-row">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.list-row /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>
        <Style Selector="Button.list-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource MapWizardControlHoverBrush}" />
        </Style>

        <Style Selector="Border.row-icon-plate">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource MapWizardAccentBrush}" />
            <Setter Property="Opacity" Value="0.16" />
        </Style>
        <Style Selector="Button.list-row:pointerover Border.row-icon-plate">
            <Setter Property="Opacity" Value="0.34" />
        </Style>

        <!-- Chevron only shows while the row is hovered. -->
        <Style Selector="Border.row-chevron">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.list-row:pointerover Border.row-chevron">
            <Setter Property="Opacity" Value="0.9" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" RowSpacing="18">
        <StackPanel Grid.Row="0"
                    Spacing="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Image Source="/Assets/app-icon-256.png"
                   Width="80"
                   Height="80"
                   HorizontalAlignment="Center"
                   Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="Welcome to MapWizard"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <appControls:SmoothScrollViewer Grid.Row="1"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalContentAlignment="Center">
            <Grid ColumnDefinitions="2*,*"
                  ColumnSpacing="32"
                  MaxWidth="1080"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center">
                <!-- Left column: tools -->
                <StackPanel Grid.Column="0">
                    <TextBlock Classes="section-label" Text="TOOLS" />
                    <ItemsControl ItemsSource="{Binding Tools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:QuickStartTool">
                                <Button Classes="list-row" HorizontalAlignment="Stretch"
                                        Click="OpenTool_OnClick" ToolTip.Tip="{Binding Description}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <Grid Width="38" Height="38">
                                            <Border Classes="row-icon-plate" />
                                            <LucideIcon Kind="{Binding Icon}" Size="19"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Foreground="{DynamicResource MapWizardTextBrush}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MapWizardTextSecondaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="row-chevron" VerticalAlignment="Center">
                                            <LucideIcon Kind="ChevronRight" Size="16"
                                                        Foreground="{DynamicResource MapWizardTextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Right column: quick actions and support -->
                <StackPanel Grid.Column="1" Spacing="24">
                    <StackPanel>
                        <TextBlock Classes="section-label" Text="QUICK ACTIONS" />
                        <StackPanel>
                            <Button Classes="list-row" HorizontalAlignment="Stretch"
                                    Click="OpenSettings_OnClick"
                                    IsVisible="{Binding !IsSongsFolderConfigured}"
                                    ToolTip.Tip="{Binding SongsFolderStatusText}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Grid Width="38" Height="38">
                                        <Border Classes="row-icon-plate" />
                                        <LucideIcon Kind="FolderOpen" Size="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MapWizardTextBrush}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Set osu! Songs folder" FontWeight="SemiBold" />
                                        <TextBlock Text="Point Map Picker at your osu! library."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MapWizardTextSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="row-chevron" VerticalAlignment="Center">
                                        <LucideIcon Kind="ChevronRight" Size="16"
                                                    Foreground="{DynamicResource MapWizardTextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Button Classes="list-row" HorizontalAlignment="Stretch"
                                    Click="OpenSettings_OnClick" ToolTip.Tip="Open settings">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Grid Width="38" Height="38">
                                        <Border Classes="row-icon-plate" />
                                        <LucideIcon Kind="Settings" Size="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MapWizardTextBrush}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Open settings" FontWeight="SemiBold" />
                                        <TextBlock Text="Theme, audio, updates, and paths."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MapWizardTextSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="row-chevron" VerticalAlignment="Center">
                                        <LucideIcon Kind="ChevronRight" Size="16"
                                                    Foreground="{DynamicResource MapWizardTextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Button Classes="list-row" HorizontalAlignment="Stretch"
                                    Command="{Binding CheckForUpdatesCommand}" ToolTip.Tip="Check for updates">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Grid Width="38" Height="38">
                                        <Border Classes="row-icon-plate" />
                                        <LucideIcon Kind="RefreshCw" Size="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MapWizardTextBrush}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Check for updates" FontWeight="SemiBold" />
                                        <TextBlock Text="See if a newer MapWizard is available."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MapWizardTextSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="row-chevron" VerticalAlignment="Center">
                                        <LucideIcon Kind="ChevronRight" Size="16"
                                                    Foreground="{DynamicResource MapWizardTextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="section-label" Text="SUPPORT" />
                        <StackPanel>
                            <Button Classes="list-row" HorizontalAlignment="Stretch"
                                    Command="{Binding OpenDiscordCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Grid Width="38" Height="38">
                                        <Border Classes="row-icon-plate" />
                                        <Viewbox Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{DynamicResource MapWizardTextBrush}" Data="{StaticResource BrandDiscord}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="Join the Discord"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Border Grid.Column="2" Classes="row-chevron" VerticalAlignment="Center">
                                        <LucideIcon Kind="ChevronRight" Size="16"
                                                    Foreground="{DynamicResource MapWizardTextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Button Classes="list-row" HorizontalAlignment="Stretch"
                                    Command="{Binding OpenDocumentationCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Grid Width="38" Height="38">
                                        <Border Classes="row-icon-plate" />
                                        <LucideIcon Kind="BookOpen" Size="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MapWizardTextBrush}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="Documentation"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Border Grid.Column="2" Classes="row-chevron" VerticalAlignment="Center">
                                        <LucideIcon Kind="ChevronRight" Size="16"
                                                    Foreground="{DynamicResource MapWizardTextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Button Classes="list-row" HorizontalAlignment="Stretch"
                                    Command="{Binding OpenGithubCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Grid Width="38" Height="38">
                                        <Border Classes="row-icon-plate" />
                                        <Viewbox Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{DynamicResource MapWizardTextBrush}" Data="{StaticResource BrandGithub}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="GitHub"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Border Grid.Column="2" Classes="row-chevron" VerticalAlignment="Center">
                                        <LucideIcon Kind="ChevronRight" Size="16"
                                                    Foreground="{DynamicResource MapWizardTextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </appControls:SmoothScrollViewer>
    </Grid>
</UserControl>
