<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="clr-namespace:MapWizard.Desktop.Views.Controls"
  xmlns:appControls="clr-namespace:MapWizard.Desktop.Controls"
  xmlns:models="using:MapWizard.Desktop.Models"
  xmlns:theme="clr-namespace:MapWizard.Theme.Controls;assembly=MapWizard.Theme"
  mc:Ignorable="d"
  d:DesignWidth="760"
  d:DesignHeight="460"
  x:Class="MapWizard.Desktop.Views.Controls.BeatmapSelectionPanel"
  x:Name="Root">

  <UserControl.Styles>
    <Style Selector="Border.SelectionPanel">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource MapWizardSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MapWizardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.CombinedSelectionPanel">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.CombinedSelectionPanel.withTargets">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource MapWizardSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MapWizardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.SourceSelectionPanel">
      <Setter Property="Padding" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="Border.SourceSelectionPanel.withTargets">
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>

    <Style Selector="Border.TargetsSelectionPanel">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Grid.SourcePanelContent">
      <Setter Property="Margin" Value="12,10,12,10" />
      <Setter Property="RowSpacing" Value="7" />
    </Style>

    <Style Selector="Grid.SourcePanelContent.withTargets">
      <Setter Property="Margin" Value="0" />
      <Setter Property="RowSpacing" Value="14" />
    </Style>

    <Style Selector="Border.SourceMapCard">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="Border.SourceMapCard.withTargets.selected">
      <Setter Property="Background" Value="{DynamicResource MapWizardControlBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MapWizardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="MinHeight" Value="160" />
      <Setter Property="BoxShadow" Value="0 5 16 0 #26000000" />
    </Style>

    <Style Selector="StackPanel.SourceMapDetails.withTargets">
      <Setter Property="Margin" Value="12,8,12,8" />
    </Style>

    <Style Selector="Border.SourceDiffBackdrop.withTargets">
      <Setter Property="Background" Value="#C014181B" />
      <Setter Property="CornerRadius" Value="0,0,13,13" />
      <Setter Property="Padding" Value="10,8,10,10" />
      <Setter Property="BoxShadow" Value="0 -8 20 0 #66000000" />
    </Style>

    <Style Selector="StackPanel.SourceBody.selected">
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style Selector="Border.SourceSelectionPanel.selected Button.SourceActionButton">
      <Setter Property="Background" Value="#660B1014" />
      <Setter Property="Foreground" Value="#FFF8F9FA" />
    </Style>

    <Style Selector="Border.SourceSelectionPanel.selected Button.SourceActionButton:pointerover">
      <Setter Property="Background" Value="#99222B32" />
    </Style>

    <Style Selector="Border.SourceSelectionPanel.selected.withTargets Button.SourceActionButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MapWizardTextBrush}" />
    </Style>

    <Style Selector="Border.SourceSelectionPanel.selected.withTargets Button.SourceActionButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource MapWizardControlBackgroundBrush}" />
    </Style>

    <Style Selector="Button.MemoryActionButton">
      <Setter Property="Background" Value="{DynamicResource MapWizardControlBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource MapWizardTextBrush}" />
    </Style>

    <Style Selector="Button.MemoryActionButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource MapWizardAccent25Brush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MapWizardTextBrush}" />
    </Style>

    <Style Selector="Button.MapSourceActionButton">
      <Setter Property="MinWidth" Value="108" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style Selector="theme|BusyIndicator.AsyncActionIndicator">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="3" />
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="theme|BusyIndicator.AsyncActionIndicator /template/ Border#PART_Indicator">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="3" />
    </Style>

    <Style Selector="Grid.AsyncActionActivity.busy LucideIcon">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Grid.AsyncActionActivity.busy theme|BusyIndicator.AsyncActionIndicator">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="TextBlock.PanelTitle">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource MapWizardTextBrush}" />
    </Style>

    <Style Selector="TextBlock.FieldLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MapWizardTextSecondaryBrush}" />
    </Style>

    <Style Selector="Border.EmptyState">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource MapWizardControlBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MapWizardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="MinHeight" Value="170" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="BoxShadow" Value="0 5 16 0 #26000000" />
    </Style>

    <Style Selector="Border.EmptyState TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MapWizardTextSecondaryBrush}" />
    </Style>

    <Style Selector="Border.TargetMapsetCard">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource MapWizardControlBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MapWizardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="BoxShadow" Value="0 5 16 0 #26000000" />
    </Style>

    <Style Selector="Border.TargetMapsetHeaderClip">
      <Setter Property="CornerRadius" Value="13,13,0,0" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.TargetMapsetHeaderClip:pointerover">
      <Setter Property="Background" Value="#24FFFFFF" />
    </Style>

    <Style Selector="Border.TargetMapsetCard TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MapWizardTextBrush}" />
    </Style>

    <Style Selector="Border.TargetMapsetHeaderClip TextBlock">
      <Setter Property="Foreground" Value="#EEEEEE" />
    </Style>

    <Style Selector="Border.AddMapRow">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource MapWizardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Button.TargetRemoveButton">
      <Setter Property="Background" Value="#33E06C75" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="Button.TargetRemoveButton:pointerover">
      <Setter Property="Background" Value="#4DE06C75" />
    </Style>

    <Style Selector="Button.TargetRemoveButton LucideIcon">
      <Setter Property="Foreground" Value="#E06C75" />
    </Style>

    <Style Selector="Button.TargetSelectAllButton">
      <Setter Property="Background" Value="#33000000" />
      <Setter Property="BorderBrush" Value="#66FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="#EEEEEE" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.TargetSelectAllButton:pointerover">
      <Setter Property="Background" Value="#44FFFFFF" />
    </Style>

    <Style Selector="LucideIcon.MapsetChevron">
      <Setter Property="Kind" Value="ChevronDown" />
      <Setter Property="Size" Value="18" />
      <Setter Property="RenderTransform" Value="rotate(-90deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform"
                                         Duration="0:0:0.25">
            <TransformOperationsTransition.Easing>
              <CubicEaseOut />
            </TransformOperationsTransition.Easing>
          </TransformOperationsTransition>
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="LucideIcon.MapsetChevron.expanded">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>

    <Style Selector="theme|AnimatedHeightBorder.TargetDiffs">
      <Setter Property="CornerRadius" Value="0,0,13,13" />
      <Setter Property="Padding" Value="10,8,10,10" />
      <Setter Property="Background" Value="#C014181B" />
      <Setter Property="BoxShadow" Value="0 -8 20 0 #66000000" />
    </Style>

    <Style Selector="ToggleButton.DiffRow">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Background" Value="{DynamicResource MapWizardDiffBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MapWizardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource MapWizardTextBrush}" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  HorizontalAlignment="Stretch">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="ToggleButton.DiffRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource MapWizardDiffHoverBackground}" />
    </Style>

    <Style Selector="ToggleButton.DiffRow:checked">
      <Setter Property="Background" Value="{DynamicResource MapWizardAccent25Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MapWizardAccentBrush}" />
    </Style>

    <Style Selector="ToggleButton.DiffRow:checked:pointerover">
      <Setter Property="Background" Value="{DynamicResource MapWizardAccent50Brush}" />
    </Style>

    <Style Selector="ToggleButton.DiffRow TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MapWizardTextBrush}" />
    </Style>

    <!-- Difficulty selection indicators (class-based so over-artwork rows can
         restyle them without fighting inline local values). -->
    <Style Selector="Border.DiffIndicatorRing">
      <Setter Property="BorderBrush" Value="{DynamicResource MapWizardControlBorderBrush}" />
    </Style>

    <Style Selector="Border.DiffIndicatorRingSelected">
      <Setter Property="BorderBrush" Value="{DynamicResource MapWizardAccentBrush}" />
    </Style>

    <Style Selector="Ellipse.DiffIndicatorDot">
      <Setter Property="Fill" Value="{DynamicResource MapWizardAccentBrush}" />
    </Style>

    <Style Selector="Border.DiffIndicatorBox">
      <Setter Property="BorderBrush" Value="{DynamicResource MapWizardControlBorderBrush}" />
    </Style>

    <Style Selector="Border.DiffIndicatorBoxSelected">
      <Setter Property="Background" Value="{DynamicResource MapWizardAccentBrush}" />
    </Style>

    <Style Selector="LucideIcon.DiffIndicatorCheck">
      <Setter Property="Foreground" Value="{DynamicResource MapWizardAccentForegroundBrush}" />
    </Style>

    <!-- Over-artwork (image-safe) overrides.
         These MUST be declared after the theme-aware base styles above:
         Avalonia applies styles in declaration order (there is no selector
         specificity), so only later rules can override earlier ones. The
         source artwork/scrim behind these controls is dark in both themes,
         so they use fixed light-on-dark values. -->
    <Style Selector="TextBlock.FieldLabel.ArtworkLabel">
      <Setter Property="Foreground" Value="#FFD6DDE2" />
    </Style>

    <Style Selector="TextBlock.PanelTitle.overArtwork">
      <Setter Property="Foreground" Value="#FFF8F9FA" />
    </Style>

    <Style Selector="ToggleButton.DiffRow.OnArtwork">
      <Setter Property="Background" Value="#B014181B" />
      <Setter Property="BorderBrush" Value="#66FFFFFF" />
      <Setter Property="Foreground" Value="#FFF8F9FA" />
    </Style>

    <Style Selector="ToggleButton.DiffRow.OnArtwork TextBlock">
      <Setter Property="Foreground" Value="#FFF8F9FA" />
    </Style>

    <Style Selector="ToggleButton.DiffRow.OnArtwork:pointerover">
      <Setter Property="Background" Value="#D0222B32" />
      <Setter Property="BorderBrush" Value="#99FFFFFF" />
    </Style>

    <Style Selector="ToggleButton.DiffRow.OnArtwork:checked">
      <Setter Property="Background" Value="{DynamicResource MapWizardAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MapWizardAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MapWizardAccentForegroundBrush}" />
    </Style>

    <Style Selector="ToggleButton.DiffRow.OnArtwork:checked TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MapWizardAccentForegroundBrush}" />
    </Style>

    <Style Selector="ToggleButton.DiffRow.OnArtwork:checked:pointerover">
      <Setter Property="Background" Value="{DynamicResource MapWizardAccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MapWizardAccentHoverBrush}" />
    </Style>

    <!-- Indicator contrast over artwork: outline stays light, and selection
         uses the accent foreground so it stays visible on an accent fill. -->
    <Style Selector="ToggleButton.DiffRow.OnArtwork Border.DiffIndicatorRing">
      <Setter Property="BorderBrush" Value="#99FFFFFF" />
    </Style>

    <Style Selector="ToggleButton.DiffRow.OnArtwork Border.DiffIndicatorRingSelected">
      <Setter Property="BorderBrush" Value="{DynamicResource MapWizardAccentForegroundBrush}" />
    </Style>

    <Style Selector="ToggleButton.DiffRow.OnArtwork Ellipse.DiffIndicatorDot">
      <Setter Property="Fill" Value="{DynamicResource MapWizardAccentForegroundBrush}" />
    </Style>

    <Style Selector="ToggleButton.DiffRow.OnArtwork Border.DiffIndicatorBox">
      <Setter Property="BorderBrush" Value="#99FFFFFF" />
    </Style>
  </UserControl.Styles>

  <Border Margin="4"
          Padding="0"
          Background="Transparent"
          BorderBrush="Transparent"
          BorderThickness="0">
    <StackPanel Margin="8" Spacing="8">

      <!-- Top actions -->
      <Grid ColumnDefinitions="*,Auto"
            VerticalAlignment="Center"
            IsVisible="{Binding ShowDestinationSection, ElementName=Root}">
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
          <Button Classes="Basic Compact"
                  Command="{Binding ClearSelectionCommand, ElementName=Root}"
                  IsEnabled="{Binding CanClearSelection, ElementName=Root}"
                  ToolTip.Tip="Clear the current source and targets">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <LucideIcon Kind="CircleX" Size="18" />
              <TextBlock Text="Clear Selection" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="Basic Compact"
                  Command="{Binding OpenOriginFolderCommand, ElementName=Root}"
                  IsEnabled="{Binding HasOriginSelection, ElementName=Root}"
                  ToolTip.Tip="Open the folder of the selected source beatmap">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <LucideIcon Kind="FolderOpen" Size="18" />
              <TextBlock Text="Open Source Folder" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Source / Targets -->
      <Border Classes="CombinedSelectionPanel"
              Classes.withTargets="{Binding ShowDestinationSection, ElementName=Root}">
      <Grid ColumnDefinitions="*,48,*">

        <!-- SOURCE -->
        <Border Grid.Column="0"
                Grid.ColumnSpan="{Binding SourceColumnSpan, ElementName=Root}"
                Classes="SelectionPanel SourceSelectionPanel"
                Classes.selected="{Binding HasOriginSelection, ElementName=Root}"
                Classes.withTargets="{Binding ShowDestinationSection, ElementName=Root}">
          <Grid>
            <Border IsVisible="{Binding ShowSourceOnlyBackdrop, ElementName=Root}"
                    IsHitTestVisible="False"
                    CornerRadius="15">
              <Border.Background>
                <ImageBrush Source="{Binding OriginMap.BackgroundImage, ElementName=Root}"
                            Stretch="UniformToFill" />
              </Border.Background>
            </Border>
            <Border IsVisible="{Binding ShowSourceOnlyBackdrop, ElementName=Root}"
                    IsHitTestVisible="False"
                    CornerRadius="15">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#CC0B0E11" Offset="0" />
                  <GradientStop Color="#8514171A" Offset="0.52" />
                  <GradientStop Color="#B00B0E11" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>

          <Grid Classes="SourcePanelContent"
                Classes.withTargets="{Binding ShowDestinationSection, ElementName=Root}"
                RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <StackPanel Spacing="2">
                <TextBlock Text="Source"
                           Classes="PanelTitle"
                           Classes.overArtwork="{Binding ShowSourceOnlyBackdrop, ElementName=Root}"
                           IsVisible="{Binding ShowDestinationSection, ElementName=Root}" />
                <TextBlock Text="Beatmap"
                           Classes="PanelTitle"
                           Classes.overArtwork="{Binding ShowSourceOnlyBackdrop, ElementName=Root}"
                           IsVisible="{Binding !ShowDestinationSection, ElementName=Root}" />
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center">
                <Button Classes="Compact MemoryActionButton MapSourceActionButton"
                        Command="{Binding SetOriginFromMemoryCommand, ElementName=Root}"
                        ToolTip.Tip="{Binding OriginMemoryToolTip, ElementName=Root}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Grid Width="16"
                          Height="16"
                          Classes="AsyncActionActivity"
                          Classes.busy="{Binding SetOriginFromMemoryCommand.IsRunning, ElementName=Root}">
                      <LucideIcon Kind="Import" Size="16" />
                      <theme:BusyIndicator Classes="AsyncActionIndicator"
                                           IsRunning="{Binding SetOriginFromMemoryCommand.IsRunning, ElementName=Root}"
                                           VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="From osu!" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="Flat Compact MapSourceActionButton"
                        Command="{Binding PickOriginFileCommand, ElementName=Root}"
                        ToolTip.Tip="Open the Map Picker">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Grid Width="16"
                          Height="16"
                          Classes="AsyncActionActivity"
                          Classes.busy="{Binding PickOriginFileCommand.IsRunning, ElementName=Root}">
                      <LucideIcon Kind="FileSearch" Size="16" />
                      <theme:BusyIndicator Classes="AsyncActionIndicator"
                                           IsRunning="{Binding PickOriginFileCommand.IsRunning, ElementName=Root}"
                                           VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Map Picker" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="Basic Compact SourceActionButton"
                        Command="{Binding ClearSelectionCommand, ElementName=Root}"
                        IsEnabled="{Binding CanClearSelection, ElementName=Root}"
                        IsVisible="{Binding !ShowDestinationSection, ElementName=Root}"
                        ToolTip.Tip="Clear the selected beatmap">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <LucideIcon Kind="CircleX" Size="16" />
                    <TextBlock Text="Clear" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="Basic Compact SourceActionButton"
                        Command="{Binding OpenOriginFolderCommand, ElementName=Root}"
                        IsEnabled="{Binding HasOriginSelection, ElementName=Root}"
                        IsVisible="{Binding !ShowDestinationSection, ElementName=Root}"
                        ToolTip.Tip="Open the selected beatmap's folder">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <LucideIcon Kind="FolderOpen" Size="16" />
                    <TextBlock Text="Folder" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Classes="SourceMapCard"
                    Classes.withTargets="{Binding ShowDestinationSection, ElementName=Root}"
                    Classes.selected="{Binding HasOriginSelection, ElementName=Root}">
              <Grid>
                <Border IsVisible="{Binding ShowSourceMapCardBackdrop, ElementName=Root}"
                        IsHitTestVisible="False"
                        CornerRadius="13">
                  <Border.Background>
                    <ImageBrush Source="{Binding OriginMap.BackgroundImage, ElementName=Root}"
                                Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
                <Border Background="#A00A0A0A"
                        IsVisible="{Binding ShowSourceMapCardBackdrop, ElementName=Root}"
                        IsHitTestVisible="False"
                        CornerRadius="13" />
              <Grid RowDefinitions="Auto,*" RowSpacing="7">
            <StackPanel Grid.Row="0"
                        Classes="SourceMapDetails"
                        Classes.withTargets="{Binding ShowDestinationSection, ElementName=Root}"
                        Spacing="1"
                        IsVisible="{Binding HasOriginSelection, ElementName=Root}">
              <TextBlock Text="{Binding OriginMap.DisplayTitle, ElementName=Root}"
                         FontWeight="Bold"
                         FontSize="13"
                         Foreground="#FFF8F9FA"
                         TextTrimming="CharacterEllipsis"
                         MaxLines="1" />
              <TextBlock Text="{Binding OriginMap.DisplayDetails, ElementName=Root}"
                         FontWeight="SemiBold"
                         FontSize="11"
                         Foreground="#FFD6DDE2"
                         TextTrimming="CharacterEllipsis"
                         MaxLines="1" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Classes="SourceBody"
                        Classes.selected="{Binding HasOriginSelection, ElementName=Root}"
                        Spacing="8">
              <!-- Source difficulties -->
              <Border Classes="SourceDiffBackdrop"
                      Classes.withTargets="{Binding ShowDestinationSection, ElementName=Root}"
                      IsVisible="{Binding HasOriginSelection, ElementName=Root}">
              <StackPanel Spacing="4">
                <TextBlock Text="Difficulties" Classes="FieldLabel ArtworkLabel" />
                <ItemsControl ItemsSource="{Binding OriginDifficultyCards, ElementName=Root}"
                              HorizontalAlignment="Stretch">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <controls:CenteredWrapPanel ItemSpacing="8"
                                                  MaxItemsPerLine="4"
                                                  ItemWidth="210"
                                                  AlignLinesRight="{Binding !ShowDestinationSection, ElementName=Root}"
                                                  FillAvailableWidth="{Binding ShowDestinationSection, ElementName=Root}" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:MapsetDifficultyCard">
                      <ToggleButton Classes="DiffRow OnArtwork"
                                    IsChecked="{Binding IsSelected, Mode=OneWay}"
                                    Command="{Binding SelectOriginMapCommand, ElementName=Root}"
                                    CommandParameter="{Binding Path}">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10">
                          <Grid Width="18" Height="18"
                                VerticalAlignment="Center">
                            <Border Classes="DiffIndicatorRing"
                                    CornerRadius="9"
                                    BorderThickness="2" />
                            <Border Classes="DiffIndicatorRingSelected"
                                    CornerRadius="9"
                                    BorderThickness="2"
                                    IsVisible="{Binding IsSelected}" />
                            <Ellipse Classes="DiffIndicatorDot"
                                     Width="8" Height="8"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsSelected}" />
                          </Grid>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding DifficultyLabel}"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     MaxLines="1" />
                        </Grid>
                      </ToggleButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              </Border>

              <!-- Source empty state -->
              <Border Classes="EmptyState"
                      IsVisible="{Binding ShowOriginEmptyState, ElementName=Root}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6">
                  <LucideIcon Kind="Music"
                                              Size="34"
                                              Opacity="0.5"
                                              HorizontalAlignment="Center" />
                  <TextBlock Text="No source selected"
                             FontWeight="SemiBold"
                             FontSize="15"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding OriginEmptyPrompt, ElementName=Root}"
                             FontSize="12.5"
                             TextWrapping="Wrap"
                             TextAlignment="Center"
                             MaxWidth="320"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </Border>

            </StackPanel>
              </Grid>
              </Grid>
            </Border>
          </Grid>
          </Grid>
        </Border>

        <!-- Workflow divider -->
        <Grid Grid.Column="1"
              IsVisible="{Binding ShowDestinationSection, ElementName=Root}">
          <Border Width="1"
                  Margin="0,4"
                  HorizontalAlignment="Center"
                  Background="{DynamicResource MapWizardBorderBrush}" />
          <Border Width="32"
                  Height="36"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="{DynamicResource MapWizardSurfaceBrush}">
            <LucideIcon Kind="ArrowRight"
                                        Size="22"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource MapWizardAccentBrush}" />
          </Border>
        </Grid>

        <!-- TARGETS -->
        <Border Grid.Column="2"
                Classes="SelectionPanel TargetsSelectionPanel"
                VerticalAlignment="Stretch"
                IsVisible="{Binding ShowDestinationSection, ElementName=Root}">
          <Grid RowDefinitions="Auto,*" RowSpacing="14">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="Targets" Classes="PanelTitle" />
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center"
                          IsVisible="{Binding !HasVisibleDestinationCards, ElementName=Root}">
                <Button Classes="Compact MemoryActionButton MapSourceActionButton"
                        Command="{Binding AddDestinationFromMemoryCommand, ElementName=Root}"
                        ToolTip.Tip="{Binding DestinationMemoryToolTip, ElementName=Root}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Grid Width="16"
                          Height="16"
                          Classes="AsyncActionActivity"
                          Classes.busy="{Binding AddDestinationFromMemoryCommand.IsRunning, ElementName=Root}">
                      <LucideIcon Kind="Import" Size="16" />
                      <theme:BusyIndicator Classes="AsyncActionIndicator"
                                           IsRunning="{Binding AddDestinationFromMemoryCommand.IsRunning, ElementName=Root}"
                                           VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="From osu!" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="Flat Compact MapSourceActionButton"
                        Command="{Binding PickDestinationFileCommand, ElementName=Root}"
                        ToolTip.Tip="Open the Map Picker">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Grid Width="16"
                          Height="16"
                          Classes="AsyncActionActivity"
                          Classes.busy="{Binding PickDestinationFileCommand.IsRunning, ElementName=Root}">
                      <LucideIcon Kind="FileSearch" Size="16" />
                      <theme:BusyIndicator Classes="AsyncActionIndicator"
                                           IsRunning="{Binding PickDestinationFileCommand.IsRunning, ElementName=Root}"
                                           VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Map Picker" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="10">
              <ItemsControl ItemsSource="{Binding VisibleDestinationMapsets, ElementName=Root}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:DestinationMapsetCard">
                    <Border Classes="TargetMapsetCard">
                      <Grid>
                        <Border IsVisible="{Binding ReferenceBeatmap.HasBackgroundImage}"
                                IsHitTestVisible="False"
                                CornerRadius="13">
                          <Border.Background>
                            <ImageBrush Source="{Binding ReferenceBeatmap.BackgroundImage}"
                                        Stretch="UniformToFill" />
                          </Border.Background>
                        </Border>
                        <Border Background="#A00A0A0A"
                                IsVisible="{Binding ReferenceBeatmap.HasBackgroundImage}"
                                IsHitTestVisible="False"
                                CornerRadius="13" />
                        <Border Background="#FF14181B"
                                IsVisible="{Binding !ReferenceBeatmap.HasBackgroundImage}"
                                IsHitTestVisible="False"
                                CornerRadius="13" />
                      <StackPanel>
                        <Border Classes="TargetMapsetHeaderClip"
                                Height="60"
                                Cursor="Hand"
                                Tapped="DestinationMapsetHeader_OnTapped">
                          <Grid Margin="4,6,8,6"
                                  ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                  ColumnSpacing="6">
                              <LucideIcon Classes="MapsetChevron"
                                                          Classes.expanded="{Binding IsExpanded}"
                                                          Foreground="#EEEEEE"
                                                          Margin="6"
                                                          VerticalAlignment="Center"
                                                          IsHitTestVisible="False" />

                              <StackPanel Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Spacing="1">
                                <TextBlock Text="{Binding ReferenceBeatmap.DisplayTitle}"
                                           FontWeight="Normal"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                                <TextBlock Text="{Binding ReferenceBeatmap.DisplayDetails}"
                                           FontWeight="Normal"
                                           Opacity="0.85"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                              </StackPanel>

                              <Button Grid.Column="2"
                                      Classes="TargetSelectAllButton"
                                      Content="Select all"
                                      VerticalAlignment="Center"
                                      IsEnabled="{Binding HasUnselectedDifficulties}"
                                      Click="DestinationMapsetSelectAllButton_OnClick"
                                      ToolTip.Tip="Select all difficulties in this mapset" />

                              <Border Grid.Column="3"
                                      CornerRadius="9"
                                      Padding="8,3"
                                      Background="{DynamicResource MapWizardAccent25Brush}"
                                      BorderBrush="{DynamicResource MapWizardAccentBrush}"
                                      BorderThickness="1"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False"
                                      IsVisible="{Binding IsSuggested}">
                                <TextBlock Text="Suggested"
                                           FontSize="10.5"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource MapWizardAccentBrush}"
                                           VerticalAlignment="Center" />
                              </Border>

                              <Button Grid.Column="4"
                                      Classes="TargetRemoveButton"
                                      Click="DestinationMapsetRemoveButton_OnClick"
                                      IsVisible="{Binding !IsSuggested}"
                                      ToolTip.Tip="Remove this mapset from targets">
                                <LucideIcon Kind="X" Size="16" />
                              </Button>
                          </Grid>
                        </Border>

                        <theme:AnimatedHeightBorder Classes="TargetDiffs"
                                                    IsExpanded="{Binding IsExpanded}">
                            <ItemsControl Margin="4,0"
                                          ItemsSource="{Binding Difficulties}"
                                          HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <controls:CenteredWrapPanel ItemSpacing="8"
                                                            MaxItemsPerLine="4"
                                                            ItemWidth="210"
                                                            FillAvailableWidth="True" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="models:MapsetDifficultyCard">
                                <ToggleButton Classes="DiffRow OnArtwork"
                                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Command="{Binding ToggleDestinationMapCommand, ElementName=Root}"
                                              CommandParameter="{Binding Path}">
                                  <Grid ColumnDefinitions="Auto,*"
                                        ColumnSpacing="10">
                                    <Grid Width="18" Height="18"
                                          VerticalAlignment="Center">
                                      <Border Classes="DiffIndicatorBox"
                                              CornerRadius="5"
                                              BorderThickness="2" />
                                      <Border Classes="DiffIndicatorBoxSelected"
                                              CornerRadius="5"
                                              IsVisible="{Binding IsSelected}" />
                                      <LucideIcon Classes="DiffIndicatorCheck"
                                                                  Kind="Check"
                                                                  Size="12"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  IsVisible="{Binding IsSelected}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DifficultyLabel}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                  </Grid>
                                </ToggleButton>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </theme:AnimatedHeightBorder>
                      </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Targets empty state -->
              <Border Classes="EmptyState"
                      IsVisible="{Binding !HasVisibleDestinationCards, ElementName=Root}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6">
                  <LucideIcon Kind="ListChecks"
                                              Size="34"
                                              Opacity="0.5"
                                              HorizontalAlignment="Center" />
                  <TextBlock Text="No targets selected"
                             FontWeight="SemiBold"
                             FontSize="15"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="Choose one or more difficulties from any beatmap. You can add multiple beatmaps."
                             FontSize="12.5"
                             TextWrapping="Wrap"
                             TextAlignment="Center"
                             MaxWidth="320"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </Border>

              <!-- Add map -->
              <Border Classes="AddMapRow"
                      IsVisible="{Binding HasVisibleDestinationCards, ElementName=Root}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                      ColumnSpacing="8">
                  <Button Classes="Basic Compact"
                          Command="{Binding PickDestinationFileCommand, ElementName=Root}"
                          ToolTip.Tip="Add a beatmap to the targets">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <LucideIcon Kind="Plus" Size="16" />
                      <TextBlock Text="Add map" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="2"
                          Classes="Compact MemoryActionButton MapSourceActionButton"
                          Command="{Binding AddDestinationFromMemoryCommand, ElementName=Root}"
                          ToolTip.Tip="{Binding DestinationMemoryToolTip, ElementName=Root}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Grid Width="16"
                            Height="16"
                            Classes="AsyncActionActivity"
                            Classes.busy="{Binding AddDestinationFromMemoryCommand.IsRunning, ElementName=Root}">
                        <LucideIcon Kind="Import" Size="16" />
                        <theme:BusyIndicator Classes="AsyncActionIndicator"
                                             IsRunning="{Binding AddDestinationFromMemoryCommand.IsRunning, ElementName=Root}"
                                             VerticalAlignment="Center" />
                      </Grid>
                      <TextBlock Text="From osu!" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="3"
                          Classes="Flat Compact MapSourceActionButton"
                          Command="{Binding PickDestinationFileCommand, ElementName=Root}"
                          ToolTip.Tip="Open the Map Picker">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Grid Width="16"
                            Height="16"
                            Classes="AsyncActionActivity"
                            Classes.busy="{Binding PickDestinationFileCommand.IsRunning, ElementName=Root}">
                        <LucideIcon Kind="FileSearch" Size="16" />
                        <theme:BusyIndicator Classes="AsyncActionIndicator"
                                             IsRunning="{Binding PickDestinationFileCommand.IsRunning, ElementName=Root}"
                                             VerticalAlignment="Center" />
                      </Grid>
                      <TextBlock Text="Map Picker" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
