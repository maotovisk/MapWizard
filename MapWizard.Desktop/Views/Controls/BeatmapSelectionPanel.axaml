<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="clr-namespace:MapWizard.Desktop.Views.Controls"
  xmlns:appControls="clr-namespace:MapWizard.Desktop.Controls"
  xmlns:models="using:MapWizard.Desktop.Models"
  xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
  mc:Ignorable="d"
  d:DesignWidth="760"
  d:DesignHeight="460"
  x:Class="MapWizard.Desktop.Views.Controls.BeatmapSelectionPanel"
  x:Name="Root">

  <UserControl.Styles>
    <Style Selector="Border.SelectionPanel">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource SukiGlassCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.SourceSelectionPanel">
      <Setter Property="Padding" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="Border.SourceSelectionPanel.withTargets">
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>

    <Style Selector="Grid.SourcePanelContent">
      <Setter Property="Margin" Value="12,10,12,10" />
      <Setter Property="RowSpacing" Value="7" />
    </Style>

    <Style Selector="Grid.SourcePanelContent.withTargets">
      <Setter Property="Margin" Value="0" />
      <Setter Property="RowSpacing" Value="14" />
    </Style>

    <Style Selector="Border.SourceMapCard">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="Border.SourceMapCard.withTargets.selected">
      <Setter Property="Background" Value="{DynamicResource SukiControlTouchBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="MinHeight" Value="160" />
      <Setter Property="BoxShadow" Value="0 5 16 0 #26000000" />
    </Style>

    <Style Selector="StackPanel.SourceMapDetails.withTargets">
      <Setter Property="Margin" Value="12,8,12,8" />
    </Style>

    <Style Selector="Border.SourceDiffBackdrop.withTargets">
      <Setter Property="Background" Value="#C014181B" />
      <Setter Property="CornerRadius" Value="0,0,13,13" />
      <Setter Property="Padding" Value="10,8,10,10" />
      <Setter Property="BoxShadow" Value="0 -8 20 0 #66000000" />
    </Style>

    <Style Selector="StackPanel.SourceBody.selected">
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style Selector="Border.SourceSelectionPanel.selected TextBlock.PanelTitle">
      <Setter Property="Foreground" Value="#FFF8F9FA" />
    </Style>

    <Style Selector="Border.SourceSelectionPanel.selected.withTargets TextBlock.PanelTitle">
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
    </Style>

    <Style Selector="Border.SourceSelectionPanel.selected TextBlock.FieldLabel">
      <Setter Property="Foreground" Value="#FFD6DDE2" />
    </Style>

    <Style Selector="Border.SourceSelectionPanel.selected Button.SourceActionButton">
      <Setter Property="Background" Value="#660B1014" />
      <Setter Property="Foreground" Value="#FFF8F9FA" />
    </Style>

    <Style Selector="Border.SourceSelectionPanel.selected Button.SourceActionButton:pointerover">
      <Setter Property="Background" Value="#99222B32" />
    </Style>

    <Style Selector="Border.SourceSelectionPanel.selected.withTargets Button.SourceActionButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
    </Style>

    <Style Selector="Border.SourceSelectionPanel.selected.withTargets Button.SourceActionButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource SukiControlTouchBackground}" />
    </Style>

    <Style Selector="TextBlock.PanelTitle">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
    </Style>

    <Style Selector="TextBlock.PanelSubtitle">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
    </Style>

    <Style Selector="TextBlock.FieldLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
    </Style>

    <Style Selector="Border.EmptyState">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource SukiControlTouchBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="MinHeight" Value="170" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="BoxShadow" Value="0 5 16 0 #26000000" />
    </Style>

    <Style Selector="Border.EmptyState TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
    </Style>

    <Style Selector="Border.TargetMapsetCard">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource SukiControlTouchBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="BoxShadow" Value="0 5 16 0 #26000000" />
    </Style>

    <Style Selector="Border.TargetMapsetHeaderClip">
      <Setter Property="CornerRadius" Value="13,13,0,0" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.TargetMapsetHeaderClip:pointerover">
      <Setter Property="Background" Value="#24FFFFFF" />
    </Style>

    <Style Selector="Border.TargetMapsetCard TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
    </Style>

    <Style Selector="Border.TargetMapsetHeaderClip TextBlock">
      <Setter Property="Foreground" Value="#EEEEEE" />
    </Style>

    <Style Selector="Border.AddMapRow">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Button.TargetHeaderButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.TargetRemoveButton">
      <Setter Property="Background" Value="#33E06C75" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="Button.TargetRemoveButton:pointerover">
      <Setter Property="Background" Value="#4DE06C75" />
    </Style>

    <Style Selector="Button.TargetRemoveButton materialIcons|MaterialIcon">
      <Setter Property="Foreground" Value="#E06C75" />
    </Style>

    <Style Selector="materialIcons|MaterialIcon.MapsetChevron">
      <Setter Property="Kind" Value="ChevronRight" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>

    <Style Selector="materialIcons|MaterialIcon.MapsetChevron.expanded">
      <Setter Property="Kind" Value="ChevronDown" />
    </Style>

    <Style Selector="Border.ExpandableDiffs">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="MaxHeight" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="CornerRadius" Value="0,0,13,13" />
      <Setter Property="Padding" Value="10,8,10,10" />
      <Setter Property="Background" Value="#C014181B" />
      <Setter Property="BoxShadow" Value="0 -8 20 0 #66000000" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
          <DoubleTransition Property="MaxHeight" Duration="0:0:0.28">
            <DoubleTransition.Easing>
              <CubicEaseOut />
            </DoubleTransition.Easing>
          </DoubleTransition>
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.ExpandableDiffs.expanded">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="MaxHeight" Value="162" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <Style Selector="ToggleButton.DiffRow">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Background" Value="{DynamicResource MapWizardDiffBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  HorizontalAlignment="Stretch">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="ToggleButton.DiffRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource MapWizardDiffHoverBackground}" />
    </Style>

    <Style Selector="ToggleButton.DiffRow:checked">
      <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor25}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>

    <Style Selector="ToggleButton.DiffRow:checked:pointerover">
      <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor50}" />
    </Style>

    <Style Selector="ToggleButton.DiffRow TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
    </Style>

    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource MapWizardTooltipBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource MapWizardTooltipText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
  </UserControl.Styles>

  <Border Margin="4"
          Padding="0"
          Background="Transparent"
          BorderBrush="Transparent"
          BorderThickness="0">
    <StackPanel Margin="8" Spacing="8">

      <!-- Top actions -->
      <Grid ColumnDefinitions="*,Auto"
            VerticalAlignment="Center"
            IsVisible="{Binding ShowDestinationSection, ElementName=Root}">
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
          <Button Classes="Basic Compact"
                  Command="{ReflectionBinding ClearSelectionCommand}"
                  IsEnabled="{Binding CanClearSelection, ElementName=Root}"
                  ToolTip.Tip="Clear the current source and targets">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="18" Height="18" />
              <TextBlock Text="Clear Selection" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="Basic Compact"
                  Command="{ReflectionBinding OpenOriginFolderCommand}"
                  IsEnabled="{Binding HasOriginSelection, ElementName=Root}"
                  ToolTip.Tip="Open the folder of the selected source beatmap">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <materialIcons:MaterialIcon Kind="FolderOpen" Width="18" Height="18" />
              <TextBlock Text="Open Source Folder" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Source / Targets -->
      <Grid ColumnDefinitions="*,Auto,*"
            ColumnSpacing="12">

        <!-- SOURCE -->
        <Border Grid.Column="0"
                Grid.ColumnSpan="{Binding SourceColumnSpan, ElementName=Root}"
                Classes="SelectionPanel SourceSelectionPanel"
                Classes.selected="{Binding HasOriginSelection, ElementName=Root}"
                Classes.withTargets="{Binding ShowDestinationSection, ElementName=Root}">
          <Grid>
            <Border IsVisible="{Binding ShowSourceOnlyBackdrop, ElementName=Root}"
                    IsHitTestVisible="False"
                    CornerRadius="15">
              <Border.Background>
                <ImageBrush Source="{Binding OriginMap.BackgroundImage, ElementName=Root}"
                            Stretch="UniformToFill" />
              </Border.Background>
            </Border>
            <Border IsVisible="{Binding ShowSourceOnlyBackdrop, ElementName=Root}"
                    IsHitTestVisible="False"
                    CornerRadius="15">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#CC0B0E11" Offset="0" />
                  <GradientStop Color="#8514171A" Offset="0.52" />
                  <GradientStop Color="#B00B0E11" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>

          <Grid Classes="SourcePanelContent"
                Classes.withTargets="{Binding ShowDestinationSection, ElementName=Root}"
                RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <StackPanel Spacing="2">
                <TextBlock Text="Source"
                           Classes="PanelTitle"
                           IsVisible="{Binding ShowDestinationSection, ElementName=Root}" />
                <TextBlock Text="Beatmap"
                           Classes="PanelTitle"
                           IsVisible="{Binding !ShowDestinationSection, ElementName=Root}" />
                <TextBlock Text="{Binding SourceSubtitle, ElementName=Root}"
                           Classes="PanelSubtitle"
                           IsVisible="{Binding ShowSourceSubtitle, ElementName=Root}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center">
                <Button Classes="Basic Compact SourceActionButton"
                        Command="{ReflectionBinding SetOriginFromMemoryCommand}"
                        ToolTip.Tip="{Binding OriginMemoryToolTip, ElementName=Root}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <materialIcons:MaterialIcon Kind="Import" Width="16" Height="16" />
                    <TextBlock Text="From osu!" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="Flat Compact"
                        Command="{ReflectionBinding PickOriginFileCommand}"
                        ToolTip.Tip="Open the Map Picker">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <materialIcons:MaterialIcon Kind="FileSearchOutline" Width="16" Height="16" />
                    <TextBlock Text="Map Picker" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="Basic Compact SourceActionButton"
                        Command="{ReflectionBinding ClearSelectionCommand}"
                        IsEnabled="{Binding CanClearSelection, ElementName=Root}"
                        IsVisible="{Binding !ShowDestinationSection, ElementName=Root}"
                        ToolTip.Tip="Clear the selected beatmap">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="16" Height="16" />
                    <TextBlock Text="Clear" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="Basic Compact SourceActionButton"
                        Command="{ReflectionBinding OpenOriginFolderCommand}"
                        IsEnabled="{Binding HasOriginSelection, ElementName=Root}"
                        IsVisible="{Binding !ShowDestinationSection, ElementName=Root}"
                        ToolTip.Tip="Open the selected beatmap's folder">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <materialIcons:MaterialIcon Kind="FolderOpen" Width="16" Height="16" />
                    <TextBlock Text="Folder" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Classes="SourceMapCard"
                    Classes.withTargets="{Binding ShowDestinationSection, ElementName=Root}"
                    Classes.selected="{Binding HasOriginSelection, ElementName=Root}">
              <Grid>
                <Border IsVisible="{Binding ShowSourceMapCardBackdrop, ElementName=Root}"
                        IsHitTestVisible="False"
                        CornerRadius="13">
                  <Border.Background>
                    <ImageBrush Source="{Binding OriginMap.BackgroundImage, ElementName=Root}"
                                Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
                <Border Background="#A00A0A0A"
                        IsVisible="{Binding ShowSourceMapCardBackdrop, ElementName=Root}"
                        IsHitTestVisible="False"
                        CornerRadius="13" />
              <Grid RowDefinitions="Auto,*" RowSpacing="7">
            <StackPanel Grid.Row="0"
                        Classes="SourceMapDetails"
                        Classes.withTargets="{Binding ShowDestinationSection, ElementName=Root}"
                        Spacing="1"
                        IsVisible="{Binding HasOriginSelection, ElementName=Root}">
              <TextBlock Text="{Binding OriginMap.DisplayTitle, ElementName=Root}"
                         FontWeight="Bold"
                         FontSize="13"
                         Foreground="#FFF8F9FA"
                         TextTrimming="CharacterEllipsis"
                         MaxLines="1" />
              <TextBlock Text="{Binding OriginMap.DisplayDetails, ElementName=Root}"
                         FontWeight="SemiBold"
                         FontSize="11"
                         Foreground="#FFD6DDE2"
                         TextTrimming="CharacterEllipsis"
                         MaxLines="1" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Classes="SourceBody"
                        Classes.selected="{Binding HasOriginSelection, ElementName=Root}"
                        Spacing="8">
              <!-- Source difficulties -->
              <Border Classes="SourceDiffBackdrop"
                      Classes.withTargets="{Binding ShowDestinationSection, ElementName=Root}"
                      IsVisible="{Binding HasOriginSelection, ElementName=Root}">
              <StackPanel Spacing="4">
                <TextBlock Text="Difficulties" Classes="FieldLabel" />
                <appControls:SmoothScrollViewer MaxHeight="150"
                                                VerticalScrollBarVisibility="Hidden"
                                                HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding OriginDifficultyCards, ElementName=Root}"
                                HorizontalAlignment="Stretch">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <controls:CenteredWrapPanel ItemSpacing="8"
                                                  MaxItemsPerLine="4"
                                                  ItemWidth="210"
                                                  FillAvailableWidth="{Binding ShowDestinationSection, ElementName=Root}" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:MapsetDifficultyCard">
                      <ToggleButton Classes="DiffRow"
                                    IsChecked="{Binding IsSelected, Mode=OneWay}"
                                    Command="{ReflectionBinding DataContext.SelectOriginMapCommand, RelativeSource={RelativeSource AncestorType=controls:BeatmapSelectionPanel}}"
                                    CommandParameter="{Binding Path}">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10">
                          <Grid Width="18" Height="18"
                                VerticalAlignment="Center">
                            <Border CornerRadius="9"
                                    BorderThickness="2"
                                    BorderBrush="{DynamicResource SukiControlBorderBrush}" />
                            <Border CornerRadius="9"
                                    BorderThickness="2"
                                    BorderBrush="{DynamicResource ThemeAccentBrush}"
                                    IsVisible="{Binding IsSelected}" />
                            <Ellipse Width="8" Height="8"
                                     Fill="{DynamicResource ThemeAccentBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsSelected}" />
                          </Grid>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding DifficultyLabel}"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     MaxLines="1" />
                        </Grid>
                      </ToggleButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                </appControls:SmoothScrollViewer>
              </StackPanel>
              </Border>

              <!-- Source empty state -->
              <Border Classes="EmptyState"
                      IsVisible="{Binding ShowOriginEmptyState, ElementName=Root}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6">
                  <materialIcons:MaterialIcon Kind="MusicNoteOutline"
                                              Width="34"
                                              Height="34"
                                              Opacity="0.5"
                                              HorizontalAlignment="Center" />
                  <TextBlock Text="No source selected"
                             FontWeight="SemiBold"
                             FontSize="15"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding OriginEmptyPrompt, ElementName=Root}"
                             FontSize="12.5"
                             TextWrapping="Wrap"
                             TextAlignment="Center"
                             MaxWidth="320"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </Border>

            </StackPanel>
              </Grid>
              </Grid>
            </Border>
          </Grid>
          </Grid>
        </Border>

        <!-- Arrow -->
        <materialIcons:MaterialIcon Grid.Column="1"
                                    Kind="ArrowRight"
                                    Width="22"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource ThemeAccentBrush}"
                                    IsVisible="{Binding ShowDestinationSection, ElementName=Root}" />

        <!-- TARGETS -->
        <Border Grid.Column="2"
                Classes="SelectionPanel"
                VerticalAlignment="Stretch"
                IsVisible="{Binding ShowDestinationSection, ElementName=Root}">
          <Grid RowDefinitions="Auto,*" RowSpacing="14">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="Targets" Classes="PanelTitle" />
                <TextBlock Text="{Binding TargetSubtitle, ElementName=Root}"
                           Classes="PanelSubtitle"
                           TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center"
                          IsVisible="{Binding ShowDestinationEmptyState, ElementName=Root}">
                <Button Classes="Basic Compact"
                        Command="{ReflectionBinding AddDestinationFromMemoryCommand}"
                        ToolTip.Tip="{Binding DestinationMemoryToolTip, ElementName=Root}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <materialIcons:MaterialIcon Kind="Import" Width="16" Height="16" />
                    <TextBlock Text="From osu!" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="Flat Compact"
                        Command="{ReflectionBinding PickDestinationFileCommand}"
                        ToolTip.Tip="Open the Map Picker">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <materialIcons:MaterialIcon Kind="FileSearchOutline" Width="16" Height="16" />
                    <TextBlock Text="Map Picker" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="10">
              <ItemsControl ItemsSource="{Binding VisibleDestinationMapsets, ElementName=Root}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:DestinationMapsetCard">
                    <Border Classes="TargetMapsetCard">
                      <Grid>
                        <Border IsVisible="{Binding ReferenceBeatmap.HasBackgroundImage}"
                                IsHitTestVisible="False"
                                CornerRadius="13">
                          <Border.Background>
                            <ImageBrush Source="{Binding ReferenceBeatmap.BackgroundImage}"
                                        Stretch="UniformToFill" />
                          </Border.Background>
                        </Border>
                        <Border Background="#A00A0A0A"
                                IsVisible="{Binding ReferenceBeatmap.HasBackgroundImage}"
                                IsHitTestVisible="False"
                                CornerRadius="13" />
                      <StackPanel>
                        <Border Classes="TargetMapsetHeaderClip"
                                Height="60">
                          <Grid Margin="4,6,8,6"
                                  ColumnDefinitions="Auto,*,Auto,Auto"
                                  ColumnSpacing="6">
                              <Button Grid.ColumnSpan="4"
                                      Classes="TargetHeaderButton"
                                      Click="DestinationMapsetExpandButton_OnClick"
                                      ToolTip.Tip="Show or hide this mapset's difficulties" />

                              <materialIcons:MaterialIcon Classes="MapsetChevron"
                                                          Classes.expanded="{Binding IsExpanded}"
                                                          Foreground="#EEEEEE"
                                                          Margin="6"
                                                          VerticalAlignment="Center"
                                                          IsHitTestVisible="False" />

                              <StackPanel Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Spacing="1">
                                <TextBlock Text="{Binding ReferenceBeatmap.DisplayTitle}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                                <TextBlock Text="{Binding ReferenceBeatmap.DisplayDetails}"
                                           FontWeight="SemiBold"
                                           Opacity="0.85"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                              </StackPanel>

                              <Border Grid.Column="2"
                                      CornerRadius="9"
                                      Padding="8,3"
                                      Background="{DynamicResource SukiPrimaryColor25}"
                                      BorderBrush="{DynamicResource ThemeAccentBrush}"
                                      BorderThickness="1"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False"
                                      IsVisible="{Binding IsSuggested}">
                                <TextBlock Text="Suggested"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                           VerticalAlignment="Center" />
                              </Border>

                              <Button Grid.Column="3"
                                      Classes="TargetRemoveButton"
                                      Click="DestinationMapsetRemoveButton_OnClick"
                                      IsVisible="{Binding !IsSuggested}"
                                      ToolTip.Tip="Remove this mapset from targets">
                                <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" />
                              </Button>
                          </Grid>
                        </Border>

                        <Border Classes="ExpandableDiffs"
                                Classes.expanded="{Binding IsExpanded}">
                          <appControls:SmoothScrollViewer MaxHeight="142"
                                                          VerticalScrollBarVisibility="Hidden"
                                                          HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl Margin="0,0,0,-8"
                                          ItemsSource="{Binding Difficulties}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="models:MapsetDifficultyCard">
                                <ToggleButton Classes="DiffRow"
                                              Margin="0,0,0,8"
                                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Command="{ReflectionBinding DataContext.ToggleDestinationMapCommand, RelativeSource={RelativeSource AncestorType=controls:BeatmapSelectionPanel}}"
                                              CommandParameter="{Binding Path}">
                                  <Grid ColumnDefinitions="Auto,*"
                                        ColumnSpacing="10">
                                    <Grid Width="18" Height="18"
                                          VerticalAlignment="Center">
                                      <Border CornerRadius="5"
                                              BorderThickness="2"
                                              BorderBrush="{DynamicResource SukiControlBorderBrush}" />
                                      <Border CornerRadius="5"
                                              Background="{DynamicResource ThemeAccentBrush}"
                                              IsVisible="{Binding IsSelected}" />
                                      <materialIcons:MaterialIcon Kind="Check"
                                                                  Width="12"
                                                                  Height="12"
                                                                  Foreground="#151A0E"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  IsVisible="{Binding IsSelected}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DifficultyLabel}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                  </Grid>
                                </ToggleButton>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          </appControls:SmoothScrollViewer>
                        </Border>
                      </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Targets empty state -->
              <Border Classes="EmptyState"
                      IsVisible="{Binding !HasVisibleDestinationCards, ElementName=Root}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6">
                  <materialIcons:MaterialIcon Kind="FormatListChecks"
                                              Width="34"
                                              Height="34"
                                              Opacity="0.5"
                                              HorizontalAlignment="Center" />
                  <TextBlock Text="No targets selected"
                             FontWeight="SemiBold"
                             FontSize="15"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="Choose one or more difficulties from any beatmap. You can add multiple beatmaps."
                             FontSize="12.5"
                             TextWrapping="Wrap"
                             TextAlignment="Center"
                             MaxWidth="320"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </Border>

              <!-- Add map -->
              <Border Classes="AddMapRow"
                      IsVisible="{Binding HasVisibleDestinationCards, ElementName=Root}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                      ColumnSpacing="8">
                  <Button Classes="Basic Compact"
                          Command="{ReflectionBinding PickDestinationFileCommand}"
                          ToolTip.Tip="Add a beatmap to the targets">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16" />
                      <TextBlock Text="Add map" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="2"
                          Classes="Basic Compact"
                          Command="{ReflectionBinding AddDestinationFromMemoryCommand}"
                          ToolTip.Tip="{Binding DestinationMemoryToolTip, ElementName=Root}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <materialIcons:MaterialIcon Kind="Import" Width="16" Height="16" />
                      <TextBlock Text="From osu!" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="3"
                          Classes="Flat Compact"
                          Command="{ReflectionBinding PickDestinationFileCommand}"
                          ToolTip.Tip="Open the Map Picker">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <materialIcons:MaterialIcon Kind="FileSearchOutline" Width="16" Height="16" />
                      <TextBlock Text="Map Picker" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
