<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="clr-namespace:MapWizard.Desktop.ViewModels"
  xmlns:local="clr-namespace:MapWizard.Desktop.Converters"
  xmlns:controls="clr-namespace:MapWizard.Desktop.Views.Controls"
  xmlns:appControls="clr-namespace:MapWizard.Desktop.Controls"
  xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
  xmlns:theme="clr-namespace:MapWizard.Theme.Controls;assembly=MapWizard.Theme"
  xmlns:models="using:MapWizard.Desktop.Models"
  mc:Ignorable="d"
  d:DesignWidth="800"
  d:DesignHeight="450"
  x:Class="MapWizard.Desktop.Views.MetadataManager.MetadataManagerView"
  x:Name="Root"
  x:DataType="vm:MetadataManagerViewModel"
  Padding="16">

  <UserControl.Resources>
    <local:ColorToHexConverter x:Key="ColorToHexConverter" />
    <local:AvaloniaColorToColorConverter x:Key="AvaloniaColorToColorConverter" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
      <TextBlock
        Grid.Row="0"
        Text="Metadata Manager"
        FontSize="24"
        FontWeight="Bold"
        VerticalAlignment="Center"
        Margin="16,0" />
        
      <Button Grid.Column="1"
        Classes="Flat Large"
        Command="{Binding ApplyMetadataCommand}"
        ToolTip.Tip="Export metadata to selected beatmaps">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <materialIcons:MaterialIcon Kind="ContentSave" Width="24" Height="24" />
          <TextBlock
            VerticalAlignment="Center"
            FontWeight="Bold"
            FontSize="16"
            Text="Export Metadata" />
        </StackPanel>
      </Button>
    </Grid>
    
    <Separator Grid.Row="1" Margin="0 10 0 5" />
    
    <appControls:SmoothScrollViewer Grid.Row="2">
      <StackPanel Spacing="16">

        <controls:BeatmapSelectionPanel
          OriginMap="{Binding OriginBeatmap}"
          DestinationMaps="{Binding DestinationBeatmaps}"
          SourceSubtitle="Select the beatmap to import metadata from."
          TargetSubtitle="Select the beatmaps to export the metadata to." />
        
        <!-- METADATA -->
        <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
          <theme:Surface Margin="8" Padding="12" CornerRadius="15" Grid.Column="0">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Text="Metadata" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ApplyMetadataSection, Mode=TwoWay}" />
              </Grid>
              <Separator />
              <StackPanel Spacing="8" IsEnabled="{Binding ApplyMetadataSection}">
                <theme:FieldTextBox Prefix="Title: " PlaceholderText="Title" Text="{Binding Metadata.Title, Mode=TwoWay}" />
                <theme:FieldTextBox Prefix="Romanized Title: " PlaceholderText="Romanized Title" Text="{Binding Metadata.RomanizedTitle, Mode=TwoWay}" />
                <theme:FieldTextBox Prefix="Artist: " PlaceholderText="Artist" Text="{Binding Metadata.Artist, Mode=TwoWay}" />
                <theme:FieldTextBox Prefix="Romanized Artist: " PlaceholderText="Romanized Artist" Text="{Binding Metadata.RomanizedArtist, Mode=TwoWay}" />
                <theme:FieldTextBox Prefix="Creator: " PlaceholderText="Creator" Text="{Binding Metadata.Creator, Mode=TwoWay}" />
                <theme:FieldTextBox Prefix="Source: " PlaceholderText="Source" Text="{Binding Metadata.Source, Mode=TwoWay}" />
                <theme:FieldTextBox Prefix="Tags: " PlaceholderText="Tags" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Metadata.Tags, Mode=TwoWay}" />
                <theme:FieldTextBox Prefix="Beatmap Set ID: " PlaceholderText="Beatmap Set ID" Text="{Binding Metadata.BeatmapSetId, Mode=TwoWay}" />
              </StackPanel>
            </StackPanel>
          </theme:Surface>
          
          <!-- GENERAL -->
          <theme:Surface Margin="8" Padding="12" CornerRadius="15" Grid.Column="1">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Text="General" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ApplyGeneralSection, Mode=TwoWay}" />
              </Grid>
              <Separator />
              <StackPanel Spacing="8" IsEnabled="{Binding ApplyGeneralSection}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock VerticalAlignment="Center">Preview Time</TextBlock>
                  <theme:UnitNumericUpDown Grid.Column="1"
                                           Unit="ms"
                                           Increment="1"
                                           Minimum="-1"
                                           Value="{Binding Metadata.PreviewTime, Mode=TwoWay}" />
                </Grid>
                <theme:FieldTextBox Prefix="Audio File: " PlaceholderText="Audio File" Text="{Binding Metadata.AudioFilename, Mode=TwoWay}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Overwrite background file for all difficulties" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding OverwriteBackground, Mode=TwoWay}" />
                </Grid>
                <theme:FieldTextBox IsVisible="{Binding OverwriteBackground}" Prefix="Background Image: " PlaceholderText="Background Image" Text="{Binding Metadata.BackgroundFilename, Mode=TwoWay}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Overwrite video for all difficulties" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding OverwriteVideo, Mode=TwoWay}" />
                </Grid>
                <theme:FieldTextBox IsVisible="{Binding OverwriteVideo}" Prefix="Video Offset: " PlaceholderText="Video Offset" Text="{Binding Metadata.VideoOffset, Mode=TwoWay}" />
                <theme:FieldTextBox IsVisible="{Binding OverwriteVideo}" Prefix="Video File: " PlaceholderText="Video File" Text="{Binding Metadata.VideoFilename, Mode=TwoWay}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Widescreen Support" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Metadata.WidescreenStoryboard, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Epilepsy Warning" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Metadata.EpilepsyWarning, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Letterbox in Breaks" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Metadata.LetterboxInBreaks, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Samples match playback rate" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Metadata.SamplesMatch, Mode=TwoWay}" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </theme:Surface>
        </Grid>

        <!-- COLOURS & COMBOS -->
        <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
          <theme:Surface Margin="8" Padding="12" CornerRadius="15" Grid.Column="0">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Text="Colours" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ApplyColoursSection, Mode=TwoWay}" />
              </Grid>
              <Separator />
              <StackPanel Spacing="8" IsEnabled="{Binding ApplyColoursSection}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Override Slider Track" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding SliderTrackOverride, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SliderTrackOverride}" Margin="0,8,0,0">
                  <TextBlock FontWeight="Bold" Text="Slider Track" VerticalAlignment="Center" />
                  <controls:ModernColorPicker Grid.Column="1"
                                              Margin="8,0,0,0"
                                              SelectedColor="{Binding Metadata.SliderTrackColour, Converter={StaticResource AvaloniaColorToColorConverter}, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Override Slider Border" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding SliderBorderOverride, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SliderBorderOverride}" Margin="0,8,0,0">
                  <TextBlock FontWeight="Bold" Text="Slider Border" VerticalAlignment="Center" />
                  <controls:ModernColorPicker Grid.Column="1"
                                              Margin="8,0,0,0"
                                              SelectedColor="{Binding Metadata.SliderBorderColour, Converter={StaticResource AvaloniaColorToColorConverter}, Mode=TwoWay}" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </theme:Surface>
        
          <theme:Surface Margin="8" Padding="12" CornerRadius="15" Grid.Column="1">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Text="Combos" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ApplyCombosSection, Mode=TwoWay}" />
              </Grid>
              <Separator />
              <StackPanel Spacing="8">
                <ItemsControl ItemsSource="{Binding Metadata.Colours}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:AvaloniaComboColour">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontWeight="Bold" Text="{Binding Number, StringFormat=Combo {0}}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                          <controls:ModernColorPicker VerticalAlignment="Center"
                                                      SelectedColor="{Binding Colour, Converter={StaticResource AvaloniaColorToColorConverter}, Mode=TwoWay}" />
                          <Button Classes="Basic" 
                                  Command="{ReflectionBinding DataContext.RemoveColourCommand, ElementName=Root}"
                                  CommandParameter="{Binding}" 
                                  ToolTip.Tip="Remove this colour">
                            <materialIcons:MaterialIcon Kind="Close" Width="24" Height="24" />
                          </Button>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="Basic" Command="{Binding AddColourCommand}" ToolTip.Tip="Add a new combo colour">
                  <materialIcons:MaterialIcon Kind="Add" Width="24" Height="24" />
                </Button>
              </StackPanel>
            </StackPanel>
          </theme:Surface>
        </Grid>

        <!-- OPTIONS -->
        <theme:CollapsibleSection Header="Options">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Remove Duplicate Tags" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding RemoveDuplicateTags, Mode=TwoWay}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Reset Beatmap IDs" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding ResetBeatmapIds, Mode=TwoWay}" />
            </Grid>
          </StackPanel>
        </theme:CollapsibleSection>
      </StackPanel>
    </appControls:SmoothScrollViewer>
  </Grid>
</UserControl>
