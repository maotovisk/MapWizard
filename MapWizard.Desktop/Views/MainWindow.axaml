<theme:MapWizardWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MapWizard.Desktop.ViewModels"
    xmlns:theme="clr-namespace:MapWizard.Theme.Controls;assembly=MapWizard.Theme"
    xmlns:viewControls="clr-namespace:MapWizard.Desktop.Views.Controls"
    xmlns:transitions="clr-namespace:MapWizard.Desktop.Transitions"
    x:Class="MapWizard.Desktop.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    TransparencyBackgroundFallback="{DynamicResource MapWizardWindowBackgroundBrush}"
    MinWidth="800"
    MinHeight="600"
    Width="1280"
    Height="720"
    Icon="/Assets/app-icon.png"
    Title="MapWizard">

    <theme:MapWizardWindow.Styles>
        <Style Selector="theme|NavigationButton.NavButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="theme|NavigationButton.NavButton:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="theme|NavigationButton.NavButton:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="theme|NavigationButton.NavButton:focus">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.NavIconHoverLayer">
            <Setter Property="Background" Value="{DynamicResource MapWizardAccentBrush}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="CornerRadius" Value="15" />
            <!-- Hover feedback is instant (no transitions) so the nav feels responsive. -->
            <Setter Property="Transitions"><Transitions /></Setter>
        </Style>
        <Style Selector="theme|NavigationButton.NavButton:pointerover Border.NavIconHoverLayer">
            <Setter Property="Opacity" Value="0.14" />
        </Style>
        <Style Selector="theme|NavigationButton.NavButton:pressed Border.NavIconHoverLayer">
            <Setter Property="Opacity" Value="0.18" />
        </Style>
        <Style Selector="Button.WindowControlButton">
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.WindowControlButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource MapWizardControlHoverBrush}" />
        </Style>
        <Style Selector="Button.WindowControlButton.Close:pointerover">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.TitleBarIsland">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="{DynamicResource MapWizardSurfaceOpaqueBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapWizardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="0 5 16 0 #26000000" />
        </Style>
        <Style Selector="Border.NavigationIsland">
            <Setter Property="Width" Value="96" />
            <Setter Property="Padding" Value="4,10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource MapWizardSurfaceOpaqueBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapWizardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="0 5 16 0 #26000000" />
        </Style>
        <!-- Card chrome for tool/settings pages. It sits behind the page content
             and simply fades/scales in and out as the Start page is left/entered. -->
        <Style Selector="Border.ContentIslandCard">
            <Setter Property="Background" Value="{DynamicResource MapWizardSurfaceOpaqueBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapWizardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="0 5 16 0 #26000000" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22">
                        <DoubleTransition.Easing>
                            <CubicEaseOut />
                        </DoubleTransition.Easing>
                    </DoubleTransition>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut />
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.ContentIslandCard.no-card">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <!-- Transparent host for the page content. It keeps the rounded clip so
             content cannot spill past the card corners, while the card chrome
             above it can fade and scale on its own. -->
        <Style Selector="Border.ContentIsland">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Button.TitleBarActionButton">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Button.TitleBarActionButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource MapWizardControlHoverBrush}" />
        </Style>
        <Style Selector="Button.TitleBarActionButton:pressed">
            <Setter Property="Background" Value="{DynamicResource MapWizardControlPressedBrush}" />
        </Style>
    </theme:MapWizardWindow.Styles>

    <VisualLayerManager>
        <Panel>
        <!-- Linux keeps the app-drawn shell; MainWindow removes this radius on
             Windows so the OS compositor owns the outer corners. -->
        <Border x:Name="WindowShell"
                Classes="WindowShell"
                Background="{DynamicResource MapWizardWindowBackgroundBrush}"
                CornerRadius="12"
                ClipToBounds="True">
        <Panel>
        <Border Classes="WindowBackdrop" />
        <Grid RowDefinitions="60,*">
            <!-- Window chrome is grouped into functional islands instead of a
                 full-width title bar. The transparent center remains draggable. -->
            <Grid Grid.Row="0" />

        <Grid x:Name="AppContentLayer"
              Grid.Row="1"
              ColumnDefinitions="116,*">
        <Border Grid.Column="0"
                Classes="NavigationIsland"
                Margin="10,0,0,10">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Spacing="8" HorizontalAlignment="Center">
                    <theme:NavigationButton Classes="NavButton"
                            Padding="0"
                            MinWidth="0"
                            Width="82"
                            Foreground="{DynamicResource MapWizardTextBrush}"
                            HorizontalContentAlignment="Center"
                            Command="{Binding OpenWelcomeCommand}">
                        <StackPanel Spacing="4" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Grid Width="44" Height="30">
                                <Border Classes="NavIconHoverLayer" />
                                <Border CornerRadius="15"
                                        Background="{DynamicResource MapWizardAccentBrush}"
                                        Opacity="0.20"
                                        IsVisible="{Binding IsWelcomeSelected}" />
                                <LucideIcon Kind="House" Size="18"
                                                            Foreground="{DynamicResource MapWizardTextBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Start"
                                       Width="68"
                                       FontSize="11"
                                       Foreground="{DynamicResource MapWizardTextBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </theme:NavigationButton>

                    <theme:NavigationButton Classes="NavButton"
                            Padding="0"
                            MinWidth="0"
                            Width="82"
                            Foreground="{DynamicResource MapWizardTextBrush}"
                            HorizontalContentAlignment="Center"
                            Command="{Binding OpenHitSoundCopierCommand}">
                        <StackPanel Spacing="4" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Grid Width="44" Height="30">
                                <Border Classes="NavIconHoverLayer" />
                                <Border CornerRadius="15"
                                        Background="{DynamicResource MapWizardAccentBrush}"
                                        Opacity="0.20"
                                        IsVisible="{Binding IsHitSoundCopierSelected}" />
                                <LucideIcon Kind="Copy" Size="18"
                                                            Foreground="{DynamicResource MapWizardTextBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Hitsound Copier"
                                       Width="68"
                                       FontSize="11"
                                       Foreground="{DynamicResource MapWizardTextBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </theme:NavigationButton>

                    <theme:NavigationButton Classes="NavButton"
                            Padding="0"
                            MinWidth="0"
                            Width="82"
                            Foreground="{DynamicResource MapWizardTextBrush}"
                            HorizontalContentAlignment="Center"
                            Command="{Binding OpenMetadataManagerCommand}">
                        <StackPanel Spacing="4" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Grid Width="44" Height="30">
                                <Border Classes="NavIconHoverLayer" />
                                <Border CornerRadius="15"
                                        Background="{DynamicResource MapWizardAccentBrush}"
                                        Opacity="0.20"
                                        IsVisible="{Binding IsMetadataManagerSelected}" />
                                <LucideIcon Kind="Files" Size="18"
                                                            Foreground="{DynamicResource MapWizardTextBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Metadata Manager"
                                       Width="68"
                                       FontSize="11"
                                       Foreground="{DynamicResource MapWizardTextBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </theme:NavigationButton>

                    <theme:NavigationButton Classes="NavButton"
                            Padding="0"
                            MinWidth="0"
                            Width="82"
                            Foreground="{DynamicResource MapWizardTextBrush}"
                            HorizontalContentAlignment="Center"
                            Command="{Binding OpenHitSoundVisualizerCommand}">
                        <StackPanel Spacing="4" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Grid Width="44" Height="30">
                                <Border Classes="NavIconHoverLayer" />
                                <Border CornerRadius="15"
                                        Background="{DynamicResource MapWizardAccentBrush}"
                                        Opacity="0.20"
                                        IsVisible="{Binding IsHitSoundVisualizerSelected}" />
                                <LucideIcon Kind="ChartLine" Size="18"
                                                            Foreground="{DynamicResource MapWizardTextBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="HitSound Editor"
                                       Width="68"
                                       FontSize="11"
                                       Foreground="{DynamicResource MapWizardTextBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </theme:NavigationButton>

                    <theme:NavigationButton Classes="NavButton"
                            Padding="0"
                            MinWidth="0"
                            Width="82"
                            Foreground="{DynamicResource MapWizardTextBrush}"
                            HorizontalContentAlignment="Center"
                            Command="{Binding OpenComboColourStudioCommand}">
                        <StackPanel Spacing="4" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Grid Width="44" Height="30">
                                <Border Classes="NavIconHoverLayer" />
                                <Border CornerRadius="15"
                                        Background="{DynamicResource MapWizardAccentBrush}"
                                        Opacity="0.20"
                                        IsVisible="{Binding IsComboColourStudioSelected}" />
                                <LucideIcon Kind="Palette" Size="18"
                                                            Foreground="{DynamicResource MapWizardTextBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Combo Colour Studio"
                                       Width="68"
                                       FontSize="11"
                                       Foreground="{DynamicResource MapWizardTextBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </theme:NavigationButton>

                    <theme:NavigationButton Classes="NavButton"
                            Padding="0"
                            MinWidth="0"
                            Width="82"
                            Foreground="{DynamicResource MapWizardTextBrush}"
                            HorizontalContentAlignment="Center"
                            Command="{Binding OpenMapCleanerCommand}">
                        <StackPanel Spacing="4" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Grid Width="44" Height="30">
                                <Border Classes="NavIconHoverLayer" />
                                <Border CornerRadius="15"
                                        Background="{DynamicResource MapWizardAccentBrush}"
                                        Opacity="0.20"
                                        IsVisible="{Binding IsMapCleanerSelected}" />
                                <LucideIcon Kind="BrushCleaning" Size="18"
                                                            Foreground="{DynamicResource MapWizardTextBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Map Cleaner"
                                       Width="68"
                                       FontSize="11"
                                       Foreground="{DynamicResource MapWizardTextBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </theme:NavigationButton>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center">
                    <theme:NavigationButton Classes="NavButton"
                            Padding="0"
                            MinWidth="0"
                            Width="82"
                            Foreground="{DynamicResource MapWizardTextBrush}"
                            HorizontalContentAlignment="Center"
                            Command="{Binding OpenSettingsCommand}">
                        <StackPanel Spacing="4" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Grid Width="44" Height="30">
                                <Border Classes="NavIconHoverLayer" />
                                <Border CornerRadius="15"
                                        Background="{DynamicResource MapWizardAccentBrush}"
                                        Opacity="0.20"
                                        IsVisible="{Binding IsSettingsSelected}" />
                                <LucideIcon Kind="Settings" Size="18"
                                                            Foreground="{DynamicResource MapWizardTextBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Settings"
                                       Width="68"
                                       FontSize="11"
                                       Foreground="{DynamicResource MapWizardTextBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </theme:NavigationButton>

                    <TextBlock Text="{Binding Version}"
                               Width="68"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="10"
                               Foreground="{DynamicResource MapWizardTextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Panel Grid.Column="1"
               Margin="0,0,10,10"
               x:Name="ContentIslandHost">
            <!-- Card chrome layer. A separate sibling from the content host so it
                 can fade/scale without dragging the page content with it, and so
                 its box shadow is not clipped by the content's rounded clip. -->
            <Border Classes="ContentIslandCard"
                    Classes.no-card="{Binding IsWelcomeSelected}" />
            <Border Classes="ContentIsland">
                <TransitioningContentControl Content="{Binding CurrentPageViewModel}">
                    <TransitioningContentControl.PageTransition>
                        <transitions:ScaleFadeTransition InDuration="0:0:0.3" OutDuration="0:0:0.16" />
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>
            </Border>
        </Panel>
        </Grid>
        </Grid>
        </Panel>
        </Border>

        <viewControls:ModalHost x:Name="ModalHost"
                                BackgroundBlurTarget="{Binding ElementName=WindowShell}" />

        <!-- The window-chrome islands live above the modal backdrop so the
             blur covers the whole shell plane without blurring the top islands. -->
        <Grid x:Name="TitleBarLayer"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Height="60">
            <Grid
                  Classes="WindowTitleBar"
                  Background="Transparent">
              <Grid Margin="10,8,10,10"
                    ColumnDefinitions="Auto,*,Auto,Auto"
                    ColumnSpacing="8">
                <Border x:Name="TitleIsland"
                        Classes="TitleBarIsland"
                        Padding="12,0">
                    <StackPanel Orientation="Horizontal"
                                Spacing="9"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Image Source="/Assets/app-icon-64.png"
                               Width="23"
                               Height="23"
                               Stretch="Uniform"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock Text="MapWizard"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Classes="TitleBarIsland">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Classes="TitleBarActionButton"
                                Command="{Binding OpenGithubCommand}"
                                ToolTip.Tip="View on GitHub">
                            <Viewbox Width="18" Height="18"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{DynamicResource MapWizardTextBrush}"
                                          Data="{StaticResource BrandGithub}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Classes="TitleBarActionButton"
                                Command="{Binding OpenDiscordCommand}"
                                ToolTip.Tip="Join the Discord">
                            <Viewbox Width="18" Height="18"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{DynamicResource MapWizardTextBrush}"
                                          Data="{StaticResource BrandDiscord}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3"
                        Classes="TitleBarIsland"
                        Padding="3,3">
                    <StackPanel x:Name="WindowControlsPanel"
                                Orientation="Horizontal"
                                Spacing="1"
                                VerticalAlignment="Center">
                        <Button Classes="WindowControlButton"
                                Click="MinimizeButton_OnClick"
                                ToolTip.Tip="Minimize">
                            <Path Width="18" Height="18"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M5.8 12.4 H12.2"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                  IsHitTestVisible="False" />
                        </Button>
                        <Button Classes="WindowControlButton"
                                Click="MaximizeButton_OnClick"
                                ToolTip.Tip="Maximize or restore">
                            <Panel IsHitTestVisible="False">
                                <Path x:Name="MaximizeGlyph"
                                      Width="18" Height="18"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                      IsHitTestVisible="False">
                                    <Path.Data>
                                        <RectangleGeometry Rect="5,5,8,8" RadiusX="2.6" RadiusY="2.6" />
                                    </Path.Data>
                                </Path>
                                <Path x:Name="RestoreIcon"
                                      Width="18" Height="18"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsVisible="False"
                                      Data="M7.1 5.6 H10.9 A1.8,1.8 0 0 1 12.7 7.4 V11.2"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                      IsHitTestVisible="False" />
                                <Path x:Name="RestoreFront"
                                      Width="18" Height="18"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsVisible="False"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                      IsHitTestVisible="False">
                                    <Path.Data>
                                        <RectangleGeometry Rect="4.6,7,8,8" RadiusX="2.6" RadiusY="2.6" />
                                    </Path.Data>
                                </Path>
                            </Panel>
                        </Button>
                        <Button Classes="WindowControlButton Close"
                                Click="CloseButton_OnClick"
                                ToolTip.Tip="Close">
                            <Path Width="18" Height="18"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M5.9 5.9 L12.1 12.1 M12.1 5.9 L5.9 12.1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                  IsHitTestVisible="False" />
                        </Button>
                    </StackPanel>
                </Border>
              </Grid>
            </Grid>
        </Grid>

        <viewControls:NotificationHost x:Name="NotificationHost" />

        <!-- Explicit resize grips keep CSD resizing reliable on Wayland. -->
        <Border Tag="North" Height="5" VerticalAlignment="Top" Background="Transparent" />
        <Border Tag="South" Height="5" VerticalAlignment="Bottom" Background="Transparent" />
        <Border Tag="West" Width="5" HorizontalAlignment="Left" Background="Transparent" />
        <Border Tag="East" Width="5" HorizontalAlignment="Right" Background="Transparent" />
        <Border Tag="NW" Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" />
        <Border Tag="NE" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" />
        <Border Tag="SW" Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" />
        <Border Tag="SE" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" />
        </Panel>
    </VisualLayerManager>
</theme:MapWizardWindow>
