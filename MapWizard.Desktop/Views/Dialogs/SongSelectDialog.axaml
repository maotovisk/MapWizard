<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MapWizard.Desktop.ViewModels"
    xmlns:dialogs="clr-namespace:MapWizard.Desktop.Views.Dialogs"
    xmlns:theme="clr-namespace:MapWizard.Theme.Controls;assembly=MapWizard.Theme"
    xmlns:appControls="clr-namespace:MapWizard.Desktop.Controls"
    mc:Ignorable="d"
    d:DesignWidth="920"
    d:DesignHeight="660"
    x:Class="MapWizard.Desktop.Views.Dialogs.SongSelectDialog"
    x:DataType="vm:SongSelectDialogViewModel"
    MinWidth="460"
    MinHeight="420">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PickerToolbarSurfaceBrush"
                         Color="{DynamicResource MapWizardSurfaceOpaque}"
                         Opacity="0.94" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.FloatingToolbar">
            <Setter Property="Background" Value="{StaticResource PickerToolbarSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapWizardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BoxShadow" Value="0 8 24 0 #40000000" />
        </Style>

        <Style Selector="Border.StatusPill">
            <Setter Property="Background" Value="{DynamicResource MapWizardControlBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style Selector="TextBox.PickerSearchBox">
            <Setter Property="Background" Value="{DynamicResource MapWizardSurfaceOpaqueBrush}" />
        </Style>
        <Style Selector="TextBox.PickerSearchBox:pointerover">
            <Setter Property="Background" Value="{DynamicResource MapWizardSurfaceOpaqueBrush}" />
        </Style>
        <Style Selector="TextBox.PickerSearchBox:focus-within">
            <Setter Property="Background" Value="{DynamicResource MapWizardSurfaceOpaqueBrush}" />
        </Style>
        <Style Selector="TextBox.PickerSearchBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource MapWizardSurfaceOpaqueBrush}" />
        </Style>
        <Style Selector="TextBox.PickerSearchBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource MapWizardSurfaceOpaqueBrush}" />
        </Style>
        <Style Selector="TextBox.PickerSearchBox:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource MapWizardSurfaceOpaqueBrush}" />
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <Border Classes="FloatingToolbar">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                <TextBox Classes="PickerSearchBox"
                         Height="38"
                         PlaceholderText="Search beatmaps..."
                         Text="{Binding SearchText, Mode=TwoWay}" />

                <Button Grid.Column="1"
                        Classes="Basic Compact"
                        Command="{Binding ReloadLibraryCommand}"
                        MinWidth="38"
                        MinHeight="38"
                        Padding="8"
                        ToolTip.Tip="Reload song folders and refresh results">
                    <LucideIcon Kind="RefreshCw" Size="18" />
                </Button>

                <Button Grid.Column="2"
                        Classes="Basic Compact"
                        Command="{Binding PickFilesManuallyCommand}"
                        MinWidth="38"
                        MinHeight="38"
                        Padding="8"
                        ToolTip.Tip="Open native file picker fallback">
                    <LucideIcon Kind="FolderOpen" Size="18" />
                </Button>

                <Button Grid.Column="3"
                        Classes="Basic Compact"
                        Click="ClosePickerButton_OnClick"
                        MinWidth="38"
                        MinHeight="38"
                        Padding="8"
                        ToolTip.Tip="Close">
                    <LucideIcon Kind="X" Size="18" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Classes="StatusPill">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </Border>
            </Grid>
        </Border>

        <theme:BusyArea Grid.Row="1" BusyText="Searching songs..." IsBusy="{Binding ShowBusyBox}">
            <Grid>
                <Border Classes="StatusPill"
                        Margin="2"
                        VerticalAlignment="Top"
                        IsVisible="{Binding ShowEmptyState}">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontWeight="SemiBold" />
                </Border>

                <appControls:SmoothScrollViewer x:Name="MapsetScrollViewer"
                                                ScrollChanged="MapsetScrollViewer_OnScrollChanged"
                                                HorizontalScrollBarVisibility="Disabled">
                    <appControls:SongSelectVirtualizedList x:Name="MapsetList"
                                                          ItemsSource="{Binding VisibleMapsets}">
                        <appControls:SongSelectVirtualizedList.HeaderContent>
                            <StackPanel>
                                <Border IsVisible="{Binding HasMountedLazerMapset}">
                                    <dialogs:SongMapsetCard DataContext="{Binding MountedLazerMapset}" />
                                </Border>
                                <Border IsVisible="{Binding HasOpenInStableMapset}">
                                    <dialogs:SongMapsetCard DataContext="{Binding OpenInStableMapset}" />
                                </Border>
                            </StackPanel>
                        </appControls:SongSelectVirtualizedList.HeaderContent>
                    </appControls:SongSelectVirtualizedList>
                </appControls:SmoothScrollViewer>
            </Grid>
        </theme:BusyArea>

    </Grid>
</UserControl>
