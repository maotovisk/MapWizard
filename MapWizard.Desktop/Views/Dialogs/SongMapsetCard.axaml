<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MapWizard.Desktop.ViewModels"
    xmlns:theme="clr-namespace:MapWizard.Theme.Controls;assembly=MapWizard.Theme"
    x:Class="MapWizard.Desktop.Views.Dialogs.SongMapsetCard"
    x:DataType="vm:SongMapsetCardViewModel"
    d:DesignWidth="780"
    d:DesignHeight="220"
    mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="Border.CardRoot">
            <Setter Property="Background" Value="{DynamicResource MapWizardPickerSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapWizardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="BoxShadow" Value="0 8 24 0 #66000000" />
            <Setter Property="MaxWidth" Value="600" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.CardRoot TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MapWizardTextBrush}" />
        </Style>
        <Style Selector="Border.CardRoot LucideIcon">
            <Setter Property="Foreground" Value="{DynamicResource MapWizardTextBrush}" />
        </Style>
        <Style Selector="Grid.MapsetHeader TextBlock">
            <Setter Property="Foreground" Value="#EEEEEE" />
        </Style>
        <Style Selector="Grid.MapsetHeader LucideIcon">
            <Setter Property="Foreground" Value="#D8D8D8" />
        </Style>

        <Style Selector="Button.CardHeaderHit">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.CardHeaderHit:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.CardHeaderHit:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="RenderTransform">
                <TransformGroup>
                    <TranslateTransform X="0" Y="0" />
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </TransformGroup>
            </Setter>
        </Style>

        <Style Selector="Border.DifficultyPill">
            <Setter Property="Background" Value="#2E1A1A1A" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="Border.HintPill">
            <Setter Property="Background" Value="{DynamicResource MapWizardPickerHintBackground}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style Selector="Border.MapBackground">
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.MapBackground.expanded">
            <Setter Property="CornerRadius" Value="15,15,4,4" />
        </Style>

        <Style Selector="LucideIcon.ExpansionChevron">
            <Setter Property="Kind" Value="ChevronDown" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.25">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut />
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="LucideIcon.ExpansionChevron.expanded">
            <Setter Property="RenderTransform" Value="rotate(-180deg)" />
        </Style>

        <Style Selector="Border.CardHoverHighlight">
            <Setter Property="Background" Value="{DynamicResource MapWizardAccentBrush}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="CornerRadius" Value="15" />
        </Style>
        <Style Selector="Border.CardRoot:pointerover Border.CardHoverHighlight">
            <Setter Property="Opacity" Value="0.08" />
        </Style>

        <!-- Keyboard navigation highlight: the picker's virtualized list tags the
             focused card's container with the kbd-focus class. -->
        <Style Selector=".kbd-focus Border.CardRoot">
            <Setter Property="BorderBrush" Value="{DynamicResource MapWizardAccentBrush}" />
        </Style>

        <Style Selector="theme|AnimatedHeightBorder.DetailsPanel">
            <Setter Property="Background" Value="{DynamicResource MapWizardPickerDetail}" />
            <Setter Property="Padding" Value="14,12,14,8" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="ToggleButton.DifficultyChip">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="{DynamicResource MapWizardPickerChip}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapWizardPickerChipBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ToggleButton.DifficultyChip:pointerover">
            <Setter Property="Background" Value="{DynamicResource MapWizardPickerChipHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapWizardPickerChipHoverBorder}" />
        </Style>

        <Style Selector="ToggleButton.DifficultyChip:checked">
            <Setter Property="Background" Value="{DynamicResource MapWizardPickerSelectedBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MapWizardPickerSelectedBorder}" />
        </Style>

        <Style Selector="Button.SelectMapsetDiffsButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource MapWizardTextSecondaryBrush}" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.SelectMapsetDiffsButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource MapWizardPickerActionHover}" />
            <Setter Property="Foreground" Value="{DynamicResource MapWizardTextBrush}" />
        </Style>
        <Style Selector="Button.SelectMapsetDiffsButton:pressed">
            <Setter Property="Background" Value="{DynamicResource MapWizardPickerActionPressed}" />
        </Style>
        <Style Selector="Button.SelectMapsetDiffsButton.selected">
            <Setter Property="Foreground" Value="{DynamicResource MapWizardAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Classes="CardRoot">
        <Grid RowDefinitions="Auto,Auto">
            <Grid Height="80"
                  Classes="MapsetHeader"
                  HorizontalAlignment="Stretch">
                <Border Classes="MapBackground"
                        Classes.expanded="{Binding IsExpanded}">
                    <Grid>
                        <Border Background="#141414" />

                        <Border IsVisible="{Binding HasBackgroundImage}">
                            <Border.Background>
                                <ImageBrush Source="{Binding BackgroundImage}"
                                            Stretch="UniformToFill"
                                            AlignmentX="Center"
                                            AlignmentY="Center" />
                            </Border.Background>
                        </Border>

                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#D00A0A0A" Offset="0" />
                                    <GradientStop Color="#9B0A0A0A" Offset="0.34" />
                                    <GradientStop Color="#450A0A0A" Offset="0.72" />
                                    <GradientStop Color="#300A0A0A" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Color="#64000000" Offset="0" />
                                    <GradientStop Color="#1A000000" Offset="0.55" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <Grid Margin="12,6"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                    <StackPanel VerticalAlignment="Center"
                                Spacing="2"
                                Margin="0,0,0,4">
                        <TextBlock Text="{Binding ArtistAndTitle}"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                        <TextBlock Text="{Binding CreatorLabel}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Opacity="0.94"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                        <TextBlock Text="{Binding LastEditedLabel}"
                                   FontSize="12"
                                   Opacity="0.88"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                Spacing="6"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right"
                                Margin="0">
                        <Border Classes="HintPill"
                                IsVisible="{Binding IsMountedInLazer}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <LucideIcon Kind="Pin"
                                                            Size="11"
                                                            Foreground="{DynamicResource MapWizardPickerHintIcon}" />
                                <TextBlock Text="Mounted in osu!lazer"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MapWizardPickerHintText}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="HintPill"
                                IsVisible="{Binding IsPreferredMapset}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <LucideIcon Kind="Pin"
                                                            Size="11"
                                                            Foreground="{DynamicResource MapWizardPickerHintIcon}" />
                                <TextBlock Text="Currently Selected"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MapWizardPickerHintText}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="DifficultyPill"
                                 HorizontalAlignment="Right"
                                 Margin="0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding DifficultyCountLabel}"
                                           FontSize="12"
                                            FontWeight="SemiBold" />
                                <LucideIcon Kind="CircleCheck"
                                                            Size="12"
                                                            Foreground="{DynamicResource MapWizardPickerCheckIcon}"
                                                            IsVisible="{Binding AllDifficultiesSelected}" />
                                <LucideIcon Classes="ExpansionChevron"
                                                            Classes.expanded="{Binding IsExpanded}"
                                                            Size="15" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Button Classes="CardHeaderHit"
                        Command="{Binding Owner.ToggleMapsetExpansionCommand}"
                        CommandParameter="{Binding}" />
            </Grid>

            <theme:AnimatedHeightBorder Grid.Row="1"
                                        Classes="DetailsPanel"
                                        IsExpanded="{Binding IsExpanded}">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Difficulties"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   Opacity="0.8"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="SelectMapsetDiffsButton"
                                HorizontalAlignment="Right"
                                Classes.selected="{Binding AllDifficultiesSelected}"
                                IsVisible="{Binding Owner.AllowMultipleSelection}"
                                Command="{Binding Owner.SelectAllDifficultiesInMapsetCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Select or clear all difficulties in this mapset">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <LucideIcon Kind="CheckCheck" Size="14" />
                                <TextBlock Text="{Binding SelectAllButtonLabel}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Difficulties}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SongDifficultyItemViewModel">
                            <ToggleButton Classes="DifficultyChip"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Command="{Binding Mapset.Owner.SelectDifficultyCommand}"
                                          CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <LucideIcon Kind="CircleCheck"
                                                                Size="14"
                                                                IsVisible="{Binding IsSelected}" />
                                    <TextBlock Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="260" />
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </theme:AnimatedHeightBorder>

            <Border Classes="CardHoverHighlight" Grid.RowSpan="2" />
        </Grid>
    </Border>
</UserControl>
