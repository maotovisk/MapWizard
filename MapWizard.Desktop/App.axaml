<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MapWizard.Desktop"
    xmlns:mapWizardTheme="clr-namespace:MapWizard.Theme;assembly=MapWizard.Theme"
    xmlns:converters="clr-namespace:MapWizard.Desktop.Converters"
    x:Class="MapWizard.Desktop.App">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <mapWizardTheme:MapWizardTheme />
        <!-- Desktop interaction states should respond immediately. -->
        <Style Selector="Button, ToggleButton, ListBoxItem, ComboBoxItem, MenuItem, TabItem, TreeViewItem">
            <Setter Property="Transitions"><Transitions /></Setter>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MapWizard.Desktop/Assets/BrandIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:IndexToTransformConverter x:Key="IndexToTransformConverter" />
            <!-- ThemeService populates these dictionaries from MapWizard.Theme palettes. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark" />
                <ResourceDictionary x:Key="Light" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
